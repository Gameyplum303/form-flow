[
  {
    "id": "b5d8f0e1-1c5b-4f7b-8cfa-6cab5f7fd001",
    "key": "first_name",
    "label": "First Name",
    "type": "text",
    "required": true,
    "placeholder": "Enter your first name"
  },
  {
    "id": "d9a94f62-2c2d-4c85-a238-7f1ef3e40002",
    "key": "last_name",
    "label": "Last Name",
    "type": "text",
    "required": true,
    "placeholder": "Enter your last name"
  },
  {
    "id": "ee9b5673-3e3f-4d03-8ad5-3be0f8460003",
    "key": "email",
    "label": "Email Address",
    "type": "email",
    "required": true,
    "placeholder": "Enter your email address",
    "helpText": "We will only use this address to contact you when needed."
  },
  {
    "id": "f12c4d84-4f4a-4971-bf04-5a900b5d0004",
    "key": "age",
    "label": "How old are you?",
    "type": "number",
    "required": true,
    "placeholder": "Enter your age",
    "validationConfigs": "[{\"validationType\":\"MinValue\",\"minValue\":0},{\"validationType\":\"MaxValue\",\"maxValue\":120}]"
  },
  {
    "id": "a12e5b95-5f5b-4d95-ae01-1ca3ea6d0005",
    "key": "is_student",
    "label": "Are you currently a student?",
    "type": "yes_no",
    "required": true
  },
  {
    "id": "c23f6a06-6a6b-4b45-8152-9d5bc38e0006",
    "key": "study_level",
    "label": "What is your highest level of study?",
    "type": "dropdown",
    "required": true,
    "options": [
      { "value": "high_school", "label": "High school" },
      { "value": "bachelor", "label": "Bachelor's degree" },
      { "value": "master", "label": "Master's degree" },
      { "value": "phd", "label": "PhD or higher" }
    ]
  },
  {
    "id": "d34a7b17-7b7c-4a65-9b12-4e6c49cf0007",
    "key": "contact_method",
    "label": "Preferred contact method",
    "type": "radio",
    "required": true,
    "options": [
      { "value": "email", "label": "Email" },
      { "value": "phone", "label": "Phone" },
      { "value": "text", "label": "Text message" }
    ]
  },
  {
    "id": "e45b8c28-8c8d-4d75-a4f3-5f7d1cfd0008",
    "key": "subscribe_newsletter",
    "label": "Subscribe to newsletter",
    "type": "checkbox",
    "required": false,
    "defaultValue": "false",
    "helpText": "Check this box if you want to receive updates and offers."
  },
  {
    "id": "f56c9d39-9d9e-4e85-b172-6f8e2dfe0009",
    "key": "skills",
    "label": "Which skills do you have?",
    "type": "multiselect",
    "required": true,
    "options": [
      { "value": "csharp", "label": "C#" },
      { "value": "javascript", "label": "JavaScript" },
      { "value": "sql", "label": "SQL" },
      { "value": "design", "label": "Design" },
      { "value": "management", "label": "Management" }
    ]
  },
  {
    "id": "a67d0e4a-0a0f-4f95-ba83-7f9e3c0f0010",
    "key": "campus_preference",
    "label": "Preferred campus location",
    "type": "dropdown",
    "required": true,
    "visibleIf": {
      "key": "is_student",
      "shouldEqual": true
    },
    "options": [
      { "value": "north", "label": "North campus" },
      { "value": "south", "label": "South campus" },
      { "value": "east", "label": "East campus" },
      { "value": "west", "label": "West campus" }
    ]
  },
  {
    "id": "b78e1f5b-1b1a-4fa5-8b94-8a0f4d1a0011",
    "key": "program_start",
    "label": "When did you start your current program?",
    "type": "date",
    "required": false,
    "visibleIf": {
      "key": "is_student",
      "shouldEqual": true
    }
  },
  {
    "id": "c89f2a6c-2c2b-4fb5-9ca5-9b1a5e2b0012",
    "key": "experience_rating",
    "label": "How would you rate your experience so far?",
    "type": "rating",
    "required": false,
    "helpText": "1 star is poor, 5 stars is excellent."
  },
  {
    "id": "e0b14c8e-4e4d-4fd5-8ec7-bd3c7a4d0014",
    "key": "campus_services",
    "label": "How much do you agree with these statements?",
    "type": "likert",
    "required": false,
    "rows": [
      { "value": "library", "label": "The library has the resources I need." },
      { "value": "labs", "label": "Lab equipment is up to date." },
      { "value": "advising", "label": "Advisors are easy to reach." }
    ]
  },
  {
    "id": "f1c25d9f-5f5e-4fe5-9fd8-ce4d8b5e0015",
    "key": "recommend_score",
    "label": "How likely are you to recommend this university to a friend?",
    "type": "nps",
    "required": false
  },
  {
    "id": "a2d36e0a-6a6f-4ff5-a0e9-df5e9c6f0016",
    "key": "study_hours",
    "label": "How many hours a week do you study outside class?",
    "type": "slider",
    "required": false,
    "validationConfigs": "[{\"validationType\":\"MinValue\",\"minValue\":0},{\"validationType\":\"MaxValue\",\"maxValue\":40}]"
  },
  {
    "id": "d9a03b7d-3d3c-4fc5-adb6-ac2b6f3c0013",
    "key": "comments",
    "label": "Anything else you would like to tell us?",
    "type": "long_text",
    "required": false,
    "placeholder": "Optional",
    "validationConfigs": "[{\"validationType\":\"MaxLength\",\"maxLength\":1000}]"
  }
]
