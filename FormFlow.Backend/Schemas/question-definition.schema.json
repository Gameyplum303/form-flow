{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Question Schema",
  "description": "Schema for defining questions in a form.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the question.",
      "format": "uuid"
    },
    "key": {
      "type": "string",
      "description": "Key used to reference this question."
    },
    "label": {
      "type": "string",
      "description": "Label displayed for the question."
    },
    "type": {
      "type": "string",
      "enum": ["text", "number", "yes_no", "dropdown", "radio", "checkbox", "multiselect", "long_text", "email", "date", "rating", "likert", "nps", "slider"],
      "description": "Type of input field (e.g., text, dropdown)."
    },
    "placeholder": {
      "type": "string",
      "description": "Placeholder text for the input field."
    },
    "defaultValue": {
      "description": "Default value for the question."
    },
    "visibleIf": {
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "shouldEqual": { "type": "boolean" }
      },
      "required": ["key", "equals"]
    },
    "options": {
      "type": "array",
      "description": "The choices of a choice question, or the scale (columns) of a likert grid. A likert grid without options uses Strongly disagree (1) to Strongly agree (5).",
      "items": {
        "type": "object",
        "properties": {
          "value": { "type": "string" },
          "label": { "type": "string" }
        },
        "required": ["value", "label"]
      }
    },
    "rows": {
      "type": "array",
      "description": "The statements of a likert grid, each rated on the scale in options. Answers are stored as \"rowValue=optionValue\", so a row value can't contain '='.",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "value": { "type": "string", "pattern": "^[^=]+$" },
          "label": { "type": "string" }
        },
        "required": ["value", "label"]
      }
    },
    "validationConfigs": {
      "description" : "Represents the internal structure of validation rules. NOTE: Although this schema defines validationConfigs as an array for documentation and tooling, the backend actually stores this value as a JSON-serialized string. Example backend format: \"[{\\\"validationType\\\":\\\"MinLength\\\",\\\"minLength\\\":1}]\". The QuestionValidationEngine deserializes this string at runtime.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "validationType": { "type": "string", "enum": ["MinValue", "MaxValue", "MinLength", "MaxLength", "Range"] },
          "minValue": { "type": "number" },
          "maxValue": { "type": "number" },

          "minLength": { "type": "integer", "minimum": 0 },
          "maxLength": { "type": "integer", "minimum": 0 },

          "message": { "type": "string"}
        },
        "required": ["validationType"]
      },
      "hints": [
        { "validationType": "MinLength", "minLength": 1 },
        { "validationType": "MaxLength", "maxLength": 100 },
        { "validationType": "MinValue", "minValue": 0 },
        { "validationType": "MaxValue", "maxValue": 120 },
        { "validationType": "Range", "minValue": 0, "maxValue": 10 }
      ]
    },
    "helpText": {
      "type": "string",
      "description": "Optional guidance for the user."
    }
  },
  "required": ["id", "key", "label", "type"],
  "allOf": [
    {
      "if": {
        "properties": { "type": { "enum": ["dropdown", "radio", "multiselect"] } },
        "required": ["type"]
      },
      "then": {
        "required": ["options"],
        "properties": { "options": { "minItems": 1 } }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "likert" } },
        "required": ["type"]
      },
      "then": {
        "required": ["rows"],
        "properties": { "rows": { "minItems": 1 } }
      }
    }
  ]
}