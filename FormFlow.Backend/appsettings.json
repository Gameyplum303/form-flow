{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "LiteDb": "Filename=formflow.db;Connection=shared"
  },
  "AllowedHosts": "*",
  "SeedData": {
    "DemoSurvey": true
  },
  "Jwt": {
    "Issuer": "FormFlow",
    "Audience": "FormFlow",
    "LifetimeMinutes": 480
  },
  "RateLimits": {
    "LoginPerMinute": 20,
    "SubmissionsPerMinute": 60
  }
}
