{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "LiteDb": "Filename=formflow.db;Connection=shared"
  },
  "AllowedHosts": "*",
  "SeedData": {
    "DemoSurvey": true
  },
  "Jwt": {
    "Issuer": "FormFlow",
    "Audience": "FormFlow",
    "LifetimeMinutes": 480
  },
  "RateLimits": {
    "LoginPerMinute": 20,
    "AccountPerMinute": 20,
    "SubmissionsPerMinute": 60
  },
  "SignUp": {
    "RequireApproval": true,
    "RequireEmailVerification": true
  },
  "Email": {
    "From": "FormFlow <no-reply@formflow.local>",
    "LinkBaseUrl": "http://localhost:5224/",
    "Smtp": {
      "Host": "",
      "Port": 587,
      "Username": "",
      "Password": "",
      "EnableSsl": true
    }
  }
}
