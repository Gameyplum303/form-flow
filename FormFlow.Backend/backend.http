@host = http://localhost:5164
@questionId = b5d8f0e1-1c5b-4f7b-8cfa-6cab5f7fd001
@surveyId = 00000000-0000-0000-0000-000000000000
# Admin requests use the token from the sign-in request below (VS Code REST Client and Visual Studio).
@token = {{login.response.body.$.token}}

### Sign in (Development admin: Rogers / password; professor: professor / password)
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "Rogers",
  "password": "password"
}

### List questions
GET {{host}}/api/questions
Accept: application/json

### Get one question
GET {{host}}/api/questions/{{questionId}}

### Create a question
POST {{host}}/api/questions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "key": "favorite_language",
  "label": "Favorite programming language",
  "type": "radio",
  "required": true,
  "options": [
    { "label": "C#", "value": "csharp" },
    { "label": "TypeScript", "value": "typescript" }
  ]
}

### Create a question that only shows for students
POST {{host}}/api/questions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "key": "graduation_year",
  "label": "Expected graduation year",
  "type": "number",
  "visibleIf": { "key": "is_student", "shouldEqual": true },
  "validationConfigs": "[{\"validationType\":\"Range\",\"minValue\":2020,\"maxValue\":2040}]"
}

### List surveys (copy an id into @surveyId above)
GET {{host}}/api/surveys

### Publish a survey by link only, closing on October 15 (new surveys start as drafts)
PUT {{host}}/api/surveys/{{surveyId}}/sharing
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "status": "published",
  "listed": false,
  "closesAt": "2026-10-15T17:00:00Z"
}

### Copy a survey into a new draft you own
POST {{host}}/api/surveys/{{surveyId}}/duplicate
Authorization: Bearer {{token}}

### List the survey templates
GET {{host}}/api/templates
Authorization: Bearer {{token}}

### Start a new draft from a template (copy an id from the list above)
POST {{host}}/api/templates/a6d146ae-bc2e-5d9f-bc52-d34e324635a9/use
Authorization: Bearer {{token}}

### Open a survey by the code in its share link
GET {{host}}/api/share/k7m2p9qa

### Has this browser answered already?
GET {{host}}/api/surveys/{{surveyId}}/answered?respondentId=4f9c2b7e8d1a4c3b9e6f0a2d5c8b7e1f

### A survey's questions, in order
GET {{host}}/api/surveys/{{surveyId}}/questions

### Submit answers
POST {{host}}/api/surveys/{{surveyId}}/responses
Content-Type: application/json

{
  "answers": {
    "first_name": "Ada",
    "last_name": "Lovelace",
    "email": "ada@example.com",
    "age": 28,
    "is_student": true,
    "study_level": "master",
    "contact_method": "email",
    "subscribe_newsletter": true,
    "skills": ["csharp", "sql"],
    "campus_preference": "north"
  },
  "respondentId": "4f9c2b7e8d1a4c3b9e6f0a2d5c8b7e1f"
}

### Aggregated results
GET {{host}}/api/surveys/{{surveyId}}/results
Authorization: Bearer {{token}}

### Results for students only, compared by study level, with the timeline in US Eastern daylight time
GET {{host}}/api/surveys/{{surveyId}}/results?filter=is_student:true&compareBy=study_level&utcOffset=-240
Authorization: Bearer {{token}}

### Results for one week
GET {{host}}/api/surveys/{{surveyId}}/results?from=2026-09-01T00:00:00Z&to=2026-09-08T00:00:00Z
Authorization: Bearer {{token}}

### Download responses as CSV
GET {{host}}/api/surveys/{{surveyId}}/responses/export
Authorization: Bearer {{token}}

### Download only the students' responses as CSV
GET {{host}}/api/surveys/{{surveyId}}/responses/export?filter=is_student:true
Authorization: Bearer {{token}}

### Ask for a password reset link (without SMTP, read it from the outbox below)
POST {{host}}/api/auth/forgot-password
Content-Type: application/json

{
  "email": "ada@lab.example"
}

### Emails in the outbox (administrators, when no SMTP server is set)
GET {{host}}/api/accounts/outbox
Authorization: Bearer {{token}}

### Set a new password with the token from the emailed link
POST {{host}}/api/auth/reset-password
Content-Type: application/json

{
  "token": "paste-the-token-from-the-link",
  "password": "a-new-password"
}

### Verify an email address with the token from the emailed link
POST {{host}}/api/auth/verify-email
Content-Type: application/json

{
  "token": "paste-the-token-from-the-link"
}

### Change the signed-in account's password (signs out its other sessions)
POST {{host}}/api/auth/change-password
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "currentPassword": "password",
  "newPassword": "a-new-password"
}
