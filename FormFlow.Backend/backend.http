@host = http://localhost:5164
@questionId = b5d8f0e1-1c5b-4f7b-8cfa-6cab5f7fd001
@surveyId = 00000000-0000-0000-0000-000000000000
# Admin requests use the token from the sign-in request below (VS Code REST Client and Visual Studio).
@token = {{login.response.body.$.token}}

### Sign in as the admin (Development account: admin / formflow-admin)
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "formflow-admin"
}

### List questions
GET {{host}}/api/questions
Accept: application/json

### Get one question
GET {{host}}/api/questions/{{questionId}}

### Create a question
POST {{host}}/api/questions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "key": "favorite_language",
  "label": "Favorite programming language",
  "type": "radio",
  "required": true,
  "options": [
    { "label": "C#", "value": "csharp" },
    { "label": "TypeScript", "value": "typescript" }
  ]
}

### Create a question that only shows for students
POST {{host}}/api/questions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "key": "graduation_year",
  "label": "Expected graduation year",
  "type": "number",
  "visibleIf": { "key": "is_student", "shouldEqual": true },
  "validationConfigs": "[{\"validationType\":\"Range\",\"minValue\":2020,\"maxValue\":2040}]"
}

### List surveys (copy an id into @surveyId above)
GET {{host}}/api/surveys

### A survey's questions, in order
GET {{host}}/api/surveys/{{surveyId}}/questions

### Submit answers
POST {{host}}/api/surveys/{{surveyId}}/responses
Content-Type: application/json

{
  "answers": {
    "first_name": "Ada",
    "last_name": "Lovelace",
    "email": "ada@example.com",
    "age": 28,
    "is_student": true,
    "study_level": "master",
    "contact_method": "email",
    "subscribe_newsletter": true,
    "skills": ["csharp", "sql"],
    "campus_preference": "north"
  }
}

### Aggregated results
GET {{host}}/api/surveys/{{surveyId}}/results
Authorization: Bearer {{token}}

### Download responses as CSV
GET {{host}}/api/surveys/{{surveyId}}/responses/export
Authorization: Bearer {{token}}
