@using FormFlow.Blazor.Services
@implements IDisposable
@inject AdminSession Session

@* The sidebar menu. The admin area gets its own links; everywhere else gets the public ones. *@
<div class="brand-row">
    <a class="brand" href="@(AdminArea ? "/admin/surveys" : "")">@(AdminArea ? "Admin" : "FormFlow")</a>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav-list">
        @if (AdminArea)
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="/admin/surveys">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Surveys
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="/admin/questions">
                    <span class="bi bi-question-mark-nav-menu" aria-hidden="true"></span> Questions
                </NavLink>
            </div>
            @if (Session.Access.IsAdmin)
            {
                <div class="nav-item">
                    <NavLink class="nav-link" href="/admin/signups">
                        <span class="bi bi-person-plus-nav-menu" aria-hidden="true"></span> Sign-ups
                    </NavLink>
                </div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="/admin/outbox">
                        <span class="bi bi-envelope-nav-menu" aria-hidden="true"></span> Emails
                    </NavLink>
                </div>
            }
            <div class="nav-item">
                <NavLink class="nav-link" href="/surveys">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Take a Survey
                </NavLink>
            </div>
        }
        else
        {
            <div class="nav-item">
                <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                    <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="/surveys">
                    <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Take a Survey
                </NavLink>
            </div>
            @if (Session.Access.CanBuild)
            {
                <div class="nav-item">
                    <NavLink class="nav-link" href="/admin/surveys">
                        <span class="bi bi-question-mark-nav-menu" aria-hidden="true"></span> Survey Builder
                    </NavLink>
                </div>
            }
        }

        <AccountPanel ShowSignIn="!AdminArea" />
    </nav>
</div>

@code {
    /// <summary>Whether the page is in the admin area (under /admin).</summary>
    [Parameter] public bool AdminArea { get; set; }

    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
