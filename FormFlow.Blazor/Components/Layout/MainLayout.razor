@inherits LayoutComponentBase
@inject NavigationManager Nav
@using MudBlazor

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* data-interactive turns true once the circuit is connected, so browser tests know when clicks will be handled. *@
<div class="page" data-interactive="@(RendererInfo.IsInteractive ? "true" : "false")">
    <div class="sidebar">
        @if (Nav.Uri.Contains("/admin"))
        {
            <AdminNavMenu />
        }
        else{
            <NavMenu />
        }
    </div>

    <main>
        <div class="top-row px-4">
            <a href="https://github.com/Gameyplum303/form-flow" target="_blank">About</a>
        </div>

        <article class="content px-4">
            <AdminGuard>@Body</AdminGuard>
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
