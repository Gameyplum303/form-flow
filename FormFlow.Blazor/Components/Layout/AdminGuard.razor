@using FormFlow.Blazor.Services
@implements IDisposable
@inject AdminSession Session
@inject NavigationManager Nav

@* Admin pages render only for a signed-in admin. The sign-in is kept in browser storage,
   which can only be read once the page is interactive, so the check runs after render. *@
@if (!IsAdminPage)
{
    @ChildContent
}
else if (Session.IsSignedIn && !Session.IsAdmin && IsEditPage)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        Only admins can create or edit questions and surveys. You're signed in with a view-only account.
    </MudAlert>
    <MudButton Variant="Variant.Outlined" Href="/admin/surveys">Back to surveys</MudButton>
}
else if (Session.IsSignedIn)
{
    @if (!Session.IsAdmin)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
            You're signed in with a view-only account. Only admins can make changes.
        </MudAlert>
    }
    <CascadingValue Value="new AdminAccess(Session.IsAdmin)">
        @ChildContent
    </CascadingValue>
}
else
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" aria-label="Checking sign-in" />
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool IsAdminPage
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri);
            return path == "admin" || path.StartsWith("admin/") || path.StartsWith("admin?");
        }
    }

    private bool IsEditPage
    {
        get
        {
            var path = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].TrimEnd('/');
            return path.EndsWith("/create") || path.EndsWith("/edit");
        }
    }

    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        await Session.RestoreAsync();

        if (IsAdminPage && !Session.IsSignedIn)
        {
            var returnUrl = "/" + Nav.ToBaseRelativePath(Nav.Uri);
            Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}");
        }
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
