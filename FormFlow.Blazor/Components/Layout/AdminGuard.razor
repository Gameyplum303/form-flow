@using FormFlow.Blazor.Services
@using FormFlow.Data.Models
@implements IDisposable
@inject AdminSession Session
@inject NavigationManager Nav

@* Admin pages render only for accounts that build surveys: administrators and professors. The
   sign-in is kept in browser storage, which can only be read once the page is interactive, so the
   check runs after render. An administrator previewing another role sees that role's pages. *@
@if (Session.IsPreviewing)
{
    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4" data-view-as-banner>
        You're viewing the site as a @Roles.DisplayName(Session.ViewAs).
        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="BackToAdminAsync">
            Back to Administrator view
        </MudButton>
    </MudAlert>
}
@if (!IsAdminPage)
{
    @ChildContent
}
else if (Session.IsSignedIn && !Session.Access.CanBuild)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        Students can take surveys but can't open the survey builder.
    </MudAlert>
    <MudButton Variant="Variant.Outlined" Href="/surveys">Go to surveys</MudButton>
}
else if (Session.IsSignedIn)
{
    <CascadingValue Value="Session.Access">
        @ChildContent
    </CascadingValue>
}
else
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" aria-label="Checking sign-in" />
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool IsAdminPage => Nav.IsAdminArea();

    private async Task BackToAdminAsync()
    {
        await Session.SetViewAsAsync(null);
        Nav.NavigateTo("/admin/surveys");
    }

    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        await Session.RestoreAsync();

        if (IsAdminPage && !Session.IsSignedIn)
        {
            var returnUrl = "/" + Nav.ToBaseRelativePath(Nav.Uri);
            Nav.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}");
        }
    }

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
