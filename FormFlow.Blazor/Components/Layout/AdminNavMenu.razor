@using FormFlow.Blazor.Services
@implements IDisposable
@inject AdminSession Session

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/admin/surveys">Admin</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/admin/surveys">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span>
                Surveys
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/admin/questions">
                <span class="bi bi-question-mark-nav-menu" aria-hidden="true"></span>
                Questions
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/surveys">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span>
                Respondent view
            </NavLink>
        </div>

        @if (Session.IsSignedIn)
        {
            <div class="nav-item px-3 signed-in">
                <span class="signed-in-as">Signed in as @Session.Username</span>
                <button type="button" class="nav-link sign-out" @onclick="SignOutAsync" @onclick:stopPropagation="true">
                    <span class="bi bi-box-arrow-right-nav-menu" aria-hidden="true"></span>
                    Sign out
                </button>
            </div>
        }

    </nav>
</div>

@code {
    protected override void OnInitialized() => Session.Changed += OnSessionChanged;

    // AdminGuard sees the change and sends the browser to the sign-in page.
    private Task SignOutAsync() => Session.SignOutAsync();

    private void OnSessionChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Session.Changed -= OnSessionChanged;
}
