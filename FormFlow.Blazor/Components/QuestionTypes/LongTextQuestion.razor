@inherits SingleValueQuestionBase

@* A paragraph answer in a box that grows as people type. *@
<QuestionField Question="Question" Error="@Error" For="@InputId">
    <MudTextField T="string"
                  Value="CurrentValue"
                  ValueChanged="OnChangedAsync"
                  InputId="@InputId"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Required="@Question.Required"
                  Placeholder="@Question.Placeholder"
                  Error="HasError"
                  Lines="4"
                  Sizing="InputSizing.Auto" />
</QuestionField>
