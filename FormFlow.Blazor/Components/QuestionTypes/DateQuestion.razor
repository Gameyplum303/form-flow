@inherits TextQuestionBase

@* A date answer. Date inputs always report ISO dates (YYYY-MM-DD), the format the API stores. *@
<QuestionField Question="Question" Error="@Error" For="@InputId">
    <MudTextField T="string"
                  Value="CurrentValue"
                  ValueChanged="OnChangedAsync"
                  InputId="@InputId"
                  InputType="InputType.Date"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Required="@Question.Required"
                  Placeholder="@Question.Placeholder"
                  Error="HasError" />
</QuestionField>
