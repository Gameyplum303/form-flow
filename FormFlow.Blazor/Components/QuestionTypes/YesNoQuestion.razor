@inherits QuestionComponentBase

<QuestionField Question="Question" Error="@Error">
    <MudRadioGroup T="bool?" Value="_value" ValueChanged="OnValueChanged" Class="question-options">
        <MudRadio T="bool?" Value="@((bool?)true)" Color="Color.Primary" Dense="true">Yes</MudRadio>
        <MudRadio T="bool?" Value="@((bool?)false)" Color="Color.Primary" Dense="true">No</MudRadio>
    </MudRadioGroup>
</QuestionField>

@code {
    private bool? _value;

    protected override void OnParametersSet()
    {
        if (Value is not null)
        {
            _value = VisibilityEvaluator.TryParseBool(BoundValue, out var bound) ? bound : null;
        }
        else if (_value is null && VisibilityEvaluator.TryParseBool(Question.DefaultValue, out var byDefault))
        {
            _value = byDefault;
        }
    }

    private Task OnValueChanged(bool? value)
    {
        _value = value;
        return ReportAsync(value switch { true => "true", false => "false", null => null });
    }
}
