@inherits QuestionComponentBase

<QuestionField Question="Question" Error="@Error">
    <MudSelect T="string"
               Value="_value"
               ValueChanged="OnChanged"
               Variant="Variant.Outlined"
               Margin="Margin.Dense"
               Required="@Question.Required"
               Placeholder="@Question.Placeholder"
               Error="HasError"
               aria-label="@Question.Label">
        @foreach (var opt in Question.Options ?? [])
        {
            <MudSelectItem T="string" Value="@opt.Value">@opt.Label</MudSelectItem>
        }
    </MudSelect>
</QuestionField>

@code {
    private string? _value;

    protected override void OnParametersSet()
    {
        if (Value is not null)
        {
            _value = BoundValue;
        }
        else if (_value is null && Question.DefaultValue is not null)
        {
            _value = Question.DefaultValue;
        }
    }

    private Task OnChanged(string? value)
    {
        _value = value;
        return ReportAsync(value);
    }
}
