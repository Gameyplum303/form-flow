@inherits QuestionComponentBase

<QuestionField Question="Question" Error="@Error">
    <div class="question-options">
        @foreach (var opt in Question.Options ?? [])
        {
            <MudCheckBox T="bool"
                         Value="@IsSelected(opt.Value)"
                         ValueChanged="@(isChecked => ToggleSelection(opt.Value, isChecked))"
                         Color="Color.Primary"
                         Dense="true"
                         Label="@opt.Label" />
        }
    </div>
</QuestionField>

@code {
    private HashSet<string> _selected = new();

    protected override void OnParametersSet()
    {
        if (Value is not null)
        {
            _selected = Value.ToHashSet();
        }
    }

    private bool IsSelected(string value) => _selected.Contains(value);

    private Task ToggleSelection(string value, bool isChecked)
    {
        if (isChecked)
            _selected.Add(value);
        else
            _selected.Remove(value);

        // Report in option order so stored answers are stable.
        return ReportAsync(Question.Options.Select(o => o.Value).Where(_selected.Contains));
    }
}
