@inherits QuestionComponentBase

<MudPaper Elevation="1" Class="pa-4" Style="max-width:400px;">    
    <div style="margin-bottom: 1rem;">
        <label style="font-weight:600; margin-bottom:4px; display:block;">
            @Question.Label
            @if (Question.Required)
            {
                <span style="color:red">*</span>
            }
        </label>
        <MudTextField T="string"
                      Value="_value"
                      ValueChanged="OnChanged"
                      Required="@Question.Required"
                      Placeholder="@Question.Placeholder"
                      HelperText="@Question.HelpText"
                      Error="HasError"
                      ErrorText="@Error"
                      Class="my-input" />
    </div>
</MudPaper>
@code {
    private string? _value;
  
    protected override void OnParametersSet()
    {
        if (Value is not null)
        {
            _value = BoundValue;
        }
        else if (_value is null && Question.DefaultValue is not null)
        {
            _value = Question.DefaultValue;
        }
    }

    private Task OnChanged(string? value)
    {
        _value = value;
        return ReportAsync(value);
    }
}
