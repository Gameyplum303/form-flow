@inherits QuestionComponentBase

@* With options, each option is its own tick box. Without, the question is a single tick box
   that carries the question's label. *@
@if (Question.Options is { Count: > 0 })
{
    <QuestionField Question="Question" Error="@Error">
        <div class="question-options">
            @foreach (var opt in Question.Options)
            {
                <MudCheckBox T="bool"
                             Value="@_selected.Contains(opt.Value)"
                             ValueChanged="@(isChecked => ToggleOptionAsync(_selected, opt.Value, isChecked))"
                             Color="Color.Primary"
                             Dense="true"
                             Label="@opt.Label" />
            }
        </div>
    </QuestionField>
}
else
{
    <QuestionField Question="Question" Error="@Error" ShowLabel="false">
        <MudCheckBox T="bool" Value="_checked" ValueChanged="OnCheckedChangedAsync" Color="Color.Primary" Dense="true">
            <span class="question-label-inline">@Question.Label</span>
            @if (Question.Required)
            {
                <span class="question-required">*</span>
            }
        </MudCheckBox>
    </QuestionField>
}

@code {
    private bool _checked;
    private bool _initialized;
    private HashSet<string> _selected = new();

    protected override void OnParametersSet()
    {
        if (Value is not null)
        {
            _selected = Value.ToHashSet();
            _checked = VisibilityEvaluator.TryParseBool(BoundValue, out var ticked) && ticked;
        }
        else if (!_initialized && VisibilityEvaluator.TryParseBool(Question.DefaultValue, out var byDefault))
        {
            _checked = byDefault;
        }
        _initialized = true;
    }

    private Task OnCheckedChangedAsync(bool value)
    {
        _checked = value;
        return ReportAsync(value ? "true" : "false");
    }
}
