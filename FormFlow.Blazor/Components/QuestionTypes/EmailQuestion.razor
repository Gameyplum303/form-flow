@inherits SingleValueQuestionBase

@* An email address; the browser checks its shape and the server validates it. *@
<QuestionField Question="Question" Error="@Error" For="@InputId">
    <MudTextField T="string"
                  Value="CurrentValue"
                  ValueChanged="OnChangedAsync"
                  InputId="@InputId"
                  InputType="InputType.Email"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  Required="@Question.Required"
                  Placeholder="@Question.Placeholder"
                  Error="HasError" />
</QuestionField>
