@page "/Error"
@using System.Diagnostics

<PageTitle>Error</PageTitle>

<PageHeading>Something went wrong</PageHeading>
<MudAlert Severity="Severity.Error" Class="mb-4">
    An error occurred while processing your request. Try again, or go back to the home page.
</MudAlert>

@if (ShowRequestId)
{
    <MudText Typo="Typo.body2" Class="mb-4">Request ID: <code>@RequestId</code></MudText>
}

<MudButton Variant="Variant.Outlined" Color="Color.Primary" Href="/">Go home</MudButton>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
