@page "/reset-password"
@using FormFlow.Blazor.Services
@using FormFlow.Data.Services
@inject IAuthService AuthService

<PageTitle>Choose a new password</PageTitle>

<MudPaper Class="pa-6 mx-auto mt-10" MaxWidth="420px" Elevation="3">
    <MudText Typo="Typo.h5" Class="mb-4">Choose a new password</MudText>

    @if (string.IsNullOrWhiteSpace(Token))
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">This page needs the link from your password reset email.</MudAlert>
        <MudButton Variant="Variant.Text" Href="/forgot-password">Get a reset link</MudButton>
    }
    else if (_done)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4" data-reset-done>
            Your password was changed. Sign in with your new password.
        </MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login">Go to sign in</MudButton>
    }
    else
    {
        <EditForm Model="_form" OnSubmit="SaveAsync">
            <MudStack Spacing="3">
                <div>
                    <MudTextField @bind-Value="_form.Password" Label="New password" InputType="InputType.Password"
                                  Variant="Variant.Outlined" autocomplete="new-password"
                                  HelperText="@($"At least {SignUpValidator.MinimumPasswordLength} characters.")" />
                    <FieldError Errors="_errors" Field="password" />
                </div>
                <div>
                    <MudTextField @bind-Value="_form.ConfirmPassword" Label="Confirm new password" InputType="InputType.Password"
                                  Variant="Variant.Outlined" autocomplete="new-password" />
                    <FieldError Errors="_errors" Field="confirmPassword" />
                </div>
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">
                        @_error <MudLink Href="/forgot-password">Get a new link</MudLink>
                    </MudAlert>
                }
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy">
                    Save new password
                </MudButton>
            </MudStack>
        </EditForm>
    }
</MudPaper>

@code {
    [SupplyParameterFromQuery] public string? Token { get; set; }

    private readonly NewPasswordForm _form = new();
    private IReadOnlyDictionary<string, string[]> _errors = new Dictionary<string, string[]>();
    private string? _error;
    private bool _busy;
    private bool _done;

    private async Task SaveAsync()
    {
        var errors = NewPasswordForm.Check(_form.Password, _form.ConfirmPassword, "password");
        _errors = errors;
        _error = null;
        if (errors.Count > 0)
        {
            return;
        }

        _busy = true;
        var result = await AuthService.ResetPasswordAsync(Token!, _form.Password);
        _busy = false;
        _errors = result.FieldErrors;
        _error = result.Error;
        _done = result.Succeeded;
    }
}
