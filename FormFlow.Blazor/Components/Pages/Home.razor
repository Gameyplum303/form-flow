@page "/"

<PageTitle>FormFlow</PageTitle>

<MudPaper Class="pa-6 mx-auto mt-10" MaxWidth="500px" Elevation="2">
    <MudText Typo="Typo.h4" HtmlTag="h1" Class="mb-4" Align="Align.Center">
        Welcome to FormFlow
    </MudText>

    <MudText Typo="Typo.subtitle1" Class="mb-6" Align="Align.Center">
        Choose your portal
    </MudText>

    <MudStack Spacing="3" AlignItems="AlignItems.Center">

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Href="/admin/surveys"
                   StartIcon="@Icons.Material.Filled.AdminPanelSettings"
                   Class="portal-button">
            Admin Portal
        </MudButton>

        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   Href="/surveys"
                   StartIcon="@Icons.Material.Filled.Person"
                   Class="portal-button">
            Take a Survey
        </MudButton>

        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   Href="/signup"
                   StartIcon="@Icons.Material.Filled.PersonAdd"
                   Class="portal-button">
            Professor sign-up
        </MudButton>

    </MudStack>
</MudPaper>
