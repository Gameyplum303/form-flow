@page "/surveys"
@using FormFlow.Blazor.Services
@inject ISurveyService SurveyService

<PageTitle>Surveys</PageTitle>

<PageHeading>Available surveys</PageHeading>

@if (!_loaded)
{
    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
}
else if (_surveys is null)
{
    <MudAlert Severity="Severity.Error">Could not load the surveys. Please try again.</MudAlert>
}
else if (_surveys.Count == 0)
{
    <MudText>There are no surveys to take yet.</MudText>
}
else
{
    <MudGrid>
        @foreach (var survey in _surveys)
        {
            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardContent>
                        <MudText Typo="Typo.h6" HtmlTag="h2">@survey.Title</MudText>
                        <MudText Typo="Typo.body2" Class="mb-2">@survey.Description</MudText>
                        <MudText Typo="Typo.caption">@survey.QuestionIds.Count questions</MudText>
                    </MudCardContent>
                    <MudCardActions>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@($"/surveys/{survey.Id}")">
                            Take survey
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private List<SurveyDefinition>? _surveys;
    private bool _loaded;

    protected override async Task OnInitializedAsync()
    {
        _surveys = await SurveyService.GetSurveysAsync();
        _loaded = true;
    }
}
