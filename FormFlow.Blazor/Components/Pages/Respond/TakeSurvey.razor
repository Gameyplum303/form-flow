@page "/surveys/{Id:guid}"
@page "/s/{Code}"
@using FormFlow.Blazor.Services
@inject ISurveyService SurveyService
@inject IRespondentIdentity Respondent
@inject ISurveyDrafts Drafts

<PageTitle>@(_survey?.Title ?? "Survey")</PageTitle>

<MudPaper Class="pa-6" Elevation="1" MaxWidth="720px">
    @if (_loading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (_survey is null)
    {
        <MudAlert Severity="Severity.Warning">This survey does not exist or is no longer available.</MudAlert>
        <MudButton Class="mt-4" Variant="Variant.Text" Href="/surveys">Back to surveys</MudButton>
    }
    else if (_questions is null)
    {
        <PageHeading CssClass="mb-2">@_survey.Title</PageHeading>
        <MudAlert Severity="Severity.Error" Class="mb-4">Could not load this survey's questions. Please try again.</MudAlert>
        <MudButton Variant="Variant.Text" Href="/surveys">Back to surveys</MudButton>
    }
    else if (_submitted)
    {
        <PageHeading CssClass="mb-2">Thank you!</PageHeading>
        <MudText Class="mb-4">Your answers to "@_survey.Title" were recorded.</MudText>
        <MudButton Variant="Variant.Text" Href="/surveys">Back to surveys</MudButton>
    }
    else if (ClosedMessage is { } closed)
    {
        <PageHeading CssClass="mb-2">@_survey.Title</PageHeading>
        <MudAlert Severity="Severity.Info" Class="mb-4" data-survey-closed>@closed</MudAlert>
        <MudButton Variant="Variant.Text" Href="/surveys">Back to surveys</MudButton>
    }
    else
    {
        <PageHeading CssClass="mb-1">@_survey.Title</PageHeading>
        <MudText Typo="Typo.body1" Class="mb-4">@_survey.Description</MudText>

        @if (!_survey.IsPublished())
        {
            <MudAlert Severity="Severity.Info" Class="mb-4" data-draft-notice>
                This survey is a draft, so only the people who manage it can open it. Publish it from its Share page to collect answers.
            </MudAlert>
        }

        @if (_restored)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4" data-resume-note>
                We saved your answers on this device.
                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="ml-1"
                           OnClick="StartOverAsync">Start over</MudButton>
            </MudAlert>
        }

        @if (_message is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_message</MudAlert>
        }

        @* A new key starts the form afresh, on its first page, when answers are restored or cleared. *@
        <PagedSurveyForm @key="_formVersion"
                         Questions="_questions"
                         PageBreaks="_survey.PageBreaks"
                         Answers="_answers"
                         Errors="_errors"
                         AnswersChanged="OnAnswersChangedAsync"
                         OnSubmit="SubmitAsync"
                         Submitting="_submitting" />
    }
</MudPaper>

@code {
    [Parameter] public Guid Id { get; set; }

    /// <summary>The code from a share link, /s/{code}.</summary>
    [Parameter] public string? Code { get; set; }

    private SurveyDefinition? _survey;
    private List<QuestionDefinition>? _questions = [];
    private Dictionary<string, List<string>> _answers = new();
    private IReadOnlyDictionary<string, string[]>? _errors;
    private string? _message;
    private bool _loading = true;
    private bool _submitting;
    private bool _submitted;
    private bool _alreadyAnswered;

    /// <summary>Whether the answers came back from this browser's storage.</summary>
    private bool _restored;

    /// <summary>Set once the answered check and saved answers have been read from the browser.</summary>
    private bool _browserChecked;

    private int _formVersion;

    /// <summary>A message that ends the survey for this person, or null while they can still answer.</summary>
    private string? _finalMessage;

    private string? ClosedMessage =>
        _survey is null ? null
        : _survey.IsClosed(DateTime.UtcNow) ? "This survey is closed and no longer takes answers."
        : _alreadyAnswered ? "You've already answered this survey. Thank you!"
        : _finalMessage;

    protected override async Task OnInitializedAsync()
    {
        _survey = Code is not null
            ? await SurveyService.GetSurveyByShareCodeAsync(Code)
            : await SurveyService.GetSurveyAsync(Id);
        if (_survey is not null)
        {
            _questions = await SurveyService.GetSurveyQuestionsAsync(_survey.Id);
            StartOver();
        }
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The respondent id and saved answers live in browser storage, which is only readable once the
        // page is interactive. The survey may still be loading after the first render, so this runs
        // after the first render that has it.
        if (_browserChecked || _survey is null || _questions is null)
        {
            return;
        }
        _browserChecked = true;

        // When the server can't say, this is false: it still refuses a second answer on submit.
        if (_survey.IsPublished())
        {
            _alreadyAnswered = await SurveyService.HasAnsweredAsync(_survey.Id, await Respondent.GetIdAsync());
        }

        if (ClosedMessage is null && await Drafts.LoadAsync(_survey.Id) is { Count: > 0 } saved)
        {
            var keys = _questions.Select(q => q.Key).ToHashSet();
            foreach (var (key, values) in saved.Where(a => keys.Contains(a.Key)))
            {
                _answers[key] = values;
            }
            _restored = true;
            _formVersion++;
        }

        if (_alreadyAnswered || _restored)
        {
            StateHasChanged();
        }
    }

    private void StartOver()
    {
        _answers = new();
        foreach (var question in (_questions ?? []).Where(q => !string.IsNullOrWhiteSpace(q.DefaultValue)))
        {
            _answers[question.Key] = [question.DefaultValue!];
        }
        _errors = null;
        _message = null;
        _submitted = false;
    }

    private async Task OnAnswersChangedAsync()
    {
        // Clear an error as soon as the respondent changes answers; the server re-checks on submit.
        _message = null;
        await Drafts.SaveAsync(_survey!.Id, _answers);
    }

    /// <summary>Forgets the saved answers and starts the survey again.</summary>
    private async Task StartOverAsync()
    {
        await Drafts.ClearAsync(_survey!.Id);
        StartOver();
        _restored = false;
        _formVersion++;
    }

    private async Task SubmitAsync()
    {
        _submitting = true;
        _message = null;

        var result = await SurveyService.SubmitResponseAsync(_survey!.Id, _answers, await Respondent.GetIdAsync());
        _submitting = false;

        if (result.Success)
        {
            _submitted = true;
            await Drafts.ClearAsync(_survey.Id);
            return;
        }
        if (!result.CanRetry)
        {
            // Closed, gone or already answered: the saved answers can't be sent any more.
            _finalMessage = result.Message;
            await Drafts.ClearAsync(_survey.Id);
            return;
        }

        _errors = result.Errors;
        _message = result.Message ?? "Your answers could not be submitted.";
    }
}
