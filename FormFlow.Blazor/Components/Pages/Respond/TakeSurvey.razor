@page "/surveys/{Id:guid}"
@page "/s/{Code}"
@using FormFlow.Blazor.Services
@inject ISurveyService SurveyService
@inject IRespondentIdentity Respondent

<PageTitle>@(_survey?.Title ?? "Survey")</PageTitle>

<MudPaper Class="pa-6" Elevation="1" MaxWidth="720px">
    @if (_loading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (_survey is null)
    {
        <MudAlert Severity="Severity.Warning">This survey does not exist or is no longer available.</MudAlert>
        <MudButton Class="mt-4" Variant="Variant.Text" Href="/surveys">Back to surveys</MudButton>
    }
    else if (_submitted)
    {
        <PageHeading CssClass="mb-2">Thank you!</PageHeading>
        <MudText Class="mb-4">Your answers to "@_survey.Title" were recorded.</MudText>
        <MudButton Variant="Variant.Text" Href="/surveys">Back to surveys</MudButton>
    }
    else if (ClosedMessage is { } closed)
    {
        <PageHeading CssClass="mb-2">@_survey.Title</PageHeading>
        <MudAlert Severity="Severity.Info" Class="mb-4" data-survey-closed>@closed</MudAlert>
        <MudButton Variant="Variant.Text" Href="/surveys">Back to surveys</MudButton>
    }
    else
    {
        <PageHeading CssClass="mb-1">@_survey.Title</PageHeading>
        <MudText Typo="Typo.body1" Class="mb-4">@_survey.Description</MudText>

        @if (!_survey.IsPublished())
        {
            <MudAlert Severity="Severity.Info" Class="mb-4" data-draft-notice>
                This survey is a draft, so only the people who manage it can open it. Publish it from its Share page to collect answers.
            </MudAlert>
        }

        @if (_message is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_message</MudAlert>
        }

        <SurveyForm Questions="_questions" Answers="_answers" Errors="_errors" AnswersChanged="OnAnswersChanged" />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="_submitting"
                   OnClick="SubmitAsync"
                   Class="mt-2">
            @if (_submitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Submitting...</span>
            }
            else
            {
                <span>Submit</span>
            }
        </MudButton>
    }
</MudPaper>

@code {
    [Parameter] public Guid Id { get; set; }

    /// <summary>The code from a share link, /s/{code}.</summary>
    [Parameter] public string? Code { get; set; }

    private SurveyDefinition? _survey;
    private List<QuestionDefinition> _questions = [];
    private Dictionary<string, List<string>> _answers = new();
    private IReadOnlyDictionary<string, string[]>? _errors;
    private string? _message;
    private bool _loading = true;
    private bool _submitting;
    private bool _submitted;
    private bool _alreadyAnswered;

    /// <summary>A message that ends the survey for this person, or null while they can still answer.</summary>
    private string? _finalMessage;

    private string? ClosedMessage =>
        _survey is null ? null
        : _survey.IsClosed(DateTime.UtcNow) ? "This survey is closed and no longer takes answers."
        : _alreadyAnswered ? "You've already answered this survey. Thank you!"
        : _finalMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _survey = Code is not null
                ? await SurveyService.GetSurveyByShareCodeAsync(Code)
                : await SurveyService.GetSurveyAsync(Id);
            if (_survey is not null)
            {
                _questions = await SurveyService.GetSurveyQuestionsAsync(_survey.Id);
                StartOver();
            }
        }
        catch (HttpRequestException)
        {
            _survey = null;
        }
        _loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The respondent id lives in browser storage, which is only readable once the page is interactive.
        if (!firstRender || _survey is null || !_survey.IsPublished())
        {
            return;
        }

        try
        {
            _alreadyAnswered = await SurveyService.HasAnsweredAsync(_survey.Id, await Respondent.GetIdAsync());
        }
        catch (HttpRequestException)
        {
            // Not knowing is fine: the server still refuses a second answer on submit.
        }
        if (_alreadyAnswered)
        {
            StateHasChanged();
        }
    }

    private void StartOver()
    {
        _answers = new();
        foreach (var question in _questions.Where(q => !string.IsNullOrWhiteSpace(q.DefaultValue)))
        {
            _answers[question.Key] = [question.DefaultValue!];
        }
        _errors = null;
        _message = null;
        _submitted = false;
    }

    private void OnAnswersChanged()
    {
        // Clear an error as soon as the respondent changes answers; the server re-checks on submit.
        _message = null;
    }

    private async Task SubmitAsync()
    {
        _submitting = true;
        _message = null;

        var result = await SurveyService.SubmitResponseAsync(_survey!.Id, _answers, await Respondent.GetIdAsync());
        _submitting = false;

        if (result.Success)
        {
            _submitted = true;
            return;
        }
        if (!result.CanRetry)
        {
            _finalMessage = result.Message;
            return;
        }

        _errors = result.Errors;
        _message = result.Message ?? "Your answers could not be submitted.";
    }
}
