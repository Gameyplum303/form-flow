@page "/login"
@using FormFlow.Blazor.Services
@inject IAuthService Auth
@inject AdminSession Session
@inject NavigationManager Nav
@inject IConfiguration Configuration

<PageTitle>Sign in</PageTitle>

<MudPaper Class="pa-6 mx-auto mt-10" MaxWidth="420px" Elevation="2">
    <PageHeading>Sign in</PageHeading>

    @if (!string.IsNullOrWhiteSpace(Configuration["LoginHint"]))
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">@Configuration["LoginHint"]</MudAlert>
    }

    <EditForm Model="_form" OnValidSubmit="SignInAsync">
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_form.Username"
                          Label="Username or email"
                          Variant="Variant.Outlined"
                          autocomplete="username"
                          Required="true"
                          RequiredError="Enter your username or email." />
            <MudTextField @bind-Value="_form.Password"
                          Label="Password"
                          InputType="InputType.Password"
                          Variant="Variant.Outlined"
                          autocomplete="current-password"
                          Required="true"
                          RequiredError="Enter your password." />

            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
            @if (_error == AuthService.VerifyEmailMessage)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="_busy" OnClick="ResendAsync">
                    Email me a new link
                </MudButton>
            }
            @if (_notice is not null)
            {
                <MudAlert Severity="Severity.Success" Dense="true" data-verification-sent>@_notice</MudAlert>
            }

            <MudButton ButtonType="ButtonType.Submit"
                       Variant="Variant.Filled"
                       Color="Color.Primary"
                       Disabled="_busy">
                Sign in
            </MudButton>
            <MudText Typo="Typo.body2">
                <MudLink Href="/forgot-password">Forgot your password?</MudLink>
            </MudText>
            <MudText Typo="Typo.body2">
                Professor or scientist without an account? <MudLink Href="/signup">Sign up</MudLink>
            </MudText>
        </MudStack>
    </EditForm>
</MudPaper>

@code {
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private readonly LoginForm _form = new();
    private string? _error;
    private string? _notice;
    private bool _busy;

    private async Task SignInAsync()
    {
        if (string.IsNullOrWhiteSpace(_form.Username) || string.IsNullOrEmpty(_form.Password))
        {
            _error = "Enter your username or email and your password.";
            return;
        }

        _busy = true;
        _error = null;
        _notice = null;
        var (login, error) = await Auth.LoginAsync(_form.Username.Trim(), _form.Password);
        _busy = false;

        if (login is null)
        {
            _error = error;
            return;
        }

        await Session.SignInAsync(login);
        Nav.NavigateTo(Destination(ReturnUrl, Session.Access.CanBuild));
    }

    private async Task ResendAsync()
    {
        var email = _form.Username.Trim();
        _busy = true;
        var error = await Auth.ResendVerificationAsync(email);
        _busy = false;
        if (error is null)
        {
            _error = null;
            _notice = $"We sent a new verification link to {email}.";
        }
        else
        {
            _error = error;
        }
    }

    /// <summary>Students go to the surveys they can take; the survey builder is for administrators and professors.</summary>
    public static string Destination(string? returnUrl, bool canBuild)
    {
        var url = SafeReturnUrl(returnUrl);
        return canBuild || !(url == "/admin" || url.StartsWith("/admin/") || url.StartsWith("/admin?")) ? url : "/surveys";
    }

    /// <summary>Only local paths are allowed, so the sign-in page can't be used to send people to another site.</summary>
    public static string SafeReturnUrl(string? returnUrl) =>
        returnUrl is { Length: > 0 } url && url.StartsWith('/') && !url.StartsWith("//") && !url.StartsWith("/\\")
            ? url
            : "/admin/surveys";

    private sealed class LoginForm
    {
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
    }
}
