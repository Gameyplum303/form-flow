@page "/forgot-password"
@using FormFlow.Blazor.Services
@inject IAuthService AuthService

<PageTitle>Forgot your password?</PageTitle>

<MudPaper Class="pa-6 mx-auto mt-10" MaxWidth="420px" Elevation="3">
    <MudText Typo="Typo.h5" Class="mb-2">Forgot your password?</MudText>

    @if (_sentTo is not null)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4" data-reset-sent>
            If an account uses @_sentTo, we've emailed it a link to choose a new password. The link works for one hour.
        </MudAlert>
        <MudButton Variant="Variant.Text" Href="/login">Back to sign in</MudButton>
    }
    else
    {
        <MudText Class="mb-4">Enter the email address you signed up with and we'll send you a link to choose a new password.</MudText>
        <EditForm Model="_form" OnSubmit="SendAsync">
            <MudStack Spacing="3">
                <MudTextField @bind-Value="_form.Email" Label="Email" InputType="InputType.Email" Variant="Variant.Outlined"
                              autocomplete="email" />
                @if (_error is not null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                }
                <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Disabled="_busy">
                    Send reset link
                </MudButton>
                <MudText Typo="Typo.body2">Remembered it? <MudLink Href="/login">Sign in</MudLink></MudText>
            </MudStack>
        </EditForm>
    }
</MudPaper>

@code {
    private readonly EmailForm _form = new();
    private string? _error;
    private string? _sentTo;
    private bool _busy;

    private async Task SendAsync()
    {
        var email = _form.Email.Trim();
        if (!FormFlow.Data.Services.ResponseValidator.IsEmail(email))
        {
            _error = "Enter an email address, like name@example.com.";
            return;
        }

        _busy = true;
        _error = await AuthService.RequestPasswordResetAsync(email);
        _busy = false;
        if (_error is null)
        {
            _sentTo = email;
        }
    }

    private sealed class EmailForm
    {
        public string Email { get; set; } = "";
    }
}
