@page "/admin/surveys/{Id:guid}/preview"
@inject ISurveyService SurveyService

<PageTitle>Survey Preview</PageTitle>

<MudPaper Class="pa-6" Elevation="1" MaxWidth="720px">

    @if (_loading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (_survey is null)
    {
        <MudAlert Severity="Severity.Warning">Survey not found.</MudAlert>
    }
    else
    {
        <PageHeading CssClass="mb-1">@_survey.Title</PageHeading>
        <MudText Typo="Typo.body1" Class="mb-3">@_survey.Description</MudText>

        @if (_questions is null)
        {
            <MudAlert Severity="Severity.Error">Could not load the survey's questions. Please try again.</MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                Preview: conditional questions react to your answers, but nothing is saved.
            </MudAlert>

            <PagedSurveyForm Questions="_questions" PageBreaks="_survey.PageBreaks" Answers="_answers" />
        }
    }

</MudPaper>

@code {
    [Parameter] public Guid Id { get; set; }

    private SurveyDefinition? _survey;
    private List<QuestionDefinition>? _questions;
    private readonly Dictionary<string, List<string>> _answers = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        // Drafts are only served to the people who manage them; the service sends the sign-in along.
        _survey = await SurveyService.GetSurveyAsync(Id);
        if (_survey is not null)
        {
            _questions = await SurveyService.GetSurveyQuestionsAsync(Id);
        }
        _loading = false;
    }
}
