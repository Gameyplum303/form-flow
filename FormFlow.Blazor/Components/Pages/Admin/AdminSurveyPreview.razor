@page "/admin/surveys/{Id:guid}/preview"
@using Microsoft.Extensions.DependencyInjection
@inject IHttpClientFactory HttpClientFactory
@inject IServiceProvider Services
@inject NavigationManager Nav

<MudPaper Class="pa-6" Elevation="1" MaxWidth="720px">

    <PageTitle>Survey Preview</PageTitle>

    @if (_notFound)
    {
        <MudAlert Severity="Severity.Warning">Survey not found.</MudAlert>
    }
    else if (survey is null || questions is null)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else
    {
        <PageHeading CssClass="mb-1">@survey.Title</PageHeading>
        <MudText Typo="Typo.body1" Class="mb-3">@survey.Description</MudText>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
            Preview: conditional questions react to your answers, but nothing is saved.
        </MudAlert>

        <SurveyForm Questions="questions" Answers="answers" />
    }

</MudPaper>

@code {
    [Parameter] public Guid Id { get; set; }

    private SurveyDefinition? survey;
    private List<QuestionDefinition>? questions;
    private readonly Dictionary<string, List<string>> answers = new();
    private bool _notFound;

    protected override async Task OnInitializedAsync()
    {
        var client = HttpClientFactory.CreateClient("AdminApi");
        // Drafts are only served to the people who manage them, so send the sign-in along.
        Services.GetService<AdminSession>()?.Authorize(client);

        var response = await client.GetAsync($"api/surveys/{Id}");
        if (!response.IsSuccessStatusCode)
        {
            _notFound = true;
            return;
        }

        survey = await response.Content.ReadFromJsonAsync<SurveyDefinition>();
        if (survey is null)
        {
            _notFound = true;
            return;
        }

        var loaded = new List<QuestionDefinition>();

        foreach (var qid in survey.QuestionIds)
        {
            var q = await client.GetFromJsonAsync<QuestionDefinition>($"api/questions/{qid}");
            if (q != null)
                loaded.Add(q);
        }

        questions = loaded;
    }
}
