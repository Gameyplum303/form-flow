@page "/admin/questions/create"
@page "/admin/questions/{Id:guid}/edit"
@using System.Text.Json
@using System.Text.Json.Nodes
@using FormFlow.Blazor.Services
@using FormFlow.Data.Validation
@inject IQuestionService QuestionService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(IsEdit ? "Edit Question" : "Create Question")</PageTitle>

<MudPaper Class="pa-6" Elevation="1" MaxWidth="600px">
    <PageHeading>@(IsEdit ? "Edit Question" : "Create Question")</PageHeading>
    @if (_notFound)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">Question not found.</MudAlert>
        <MudButton Variant="Variant.Outlined" Href="/admin/questions">Back to questions</MudButton>
    }
    else if (_notYours)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">
            You can only edit questions you created. You can still use this one in your surveys.
        </MudAlert>
        <MudButton Variant="Variant.Outlined" Href="/admin/questions">Back to questions</MudButton>
    }
    @if (_successMessage is not null)
    {
        <MudAlert Severity="Severity.Success" 
            Class="mb-4" 
            ShowCloseIcon="true" 
            CloseIconClicked="()=> _successMessage = null">
                @_successMessage
        </MudAlert>
    }
    @if (_errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" 
            Class="mb-4" 
            ShowCloseIcon="true" 
            CloseIconClicked="()=> _errorMessage = null">
                @_errorMessage
        </MudAlert>
    }

    @if (CanEdit)
    {
    <MudForm @ref="_form" Model="@_newQuestion" @bind-IsValid="_isValid">
        <MudTextField T="string" Variant="Variant.Outlined"
                      Label="Label"
                      @bind-Value="_newQuestion.Label"
                      Required="true"
                      RequiredError="Label is required."
                      Immediate="true"
                      Class="mb-3" />

        <MudTextField T="string" Variant="Variant.Outlined"
                      Label="Key"
                      @bind-Value="_newQuestion.Key"
                      Required="true"
                      RequiredError="Key is required."
                      Immediate="true"
                      Class="mb-3" />

        <MudSelect T="string" Variant="Variant.Outlined"
                   Label="Type"
                   @bind-Value="_newQuestion.Type"
                   Required="true"
                   RequiredError="Type is required."
                   Immediate="true"
                   Class="mb-3">
            @foreach (var type in QuestionTypes.All)
            {
                <MudSelectItem Value="@type">@QuestionTypes.DisplayName(type)</MudSelectItem>
            }
        </MudSelect>

        <MudSwitch T="bool"
                   Label="Required"
                   @bind-Value="_newQuestion.Required"
                   Color="Color.Primary"
                   Class="mb-3" />

        <MudTextField T="string" Variant="Variant.Outlined"
                      Label="Placeholder"
                      @bind-Value="_newQuestion.Placeholder"
                      Immediate="true"
                      Class="mb-3" />

        <MudTextField T="string" Variant="Variant.Outlined"
                      Label="Default Value"
                      @bind-Value="_newQuestion.DefaultValue"
                      Immediate="true"
                      Class="mb-3" />

        <MudTextField T="string" Variant="Variant.Outlined"
                      Label="Help Text"
                      @bind-Value="_newQuestion.HelpText"
                      Immediate="true"
                      Lines="3"
                      Class="mb-4" />

        @if (IsLikert)
        {
            <MudText Typo="Typo.subtitle1" Class="mb-2">Rows</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">The statements people rate, one per row of the grid.</MudText>
            @if (!AreRowsValid)
            {
                <MudAlert Severity="Severity.Error" Class="mb-2">
                    Add at least one row. Each row needs a label and a value, and a value can't contain "=".
                </MudAlert>
            }

            @for (int i = 0; i < _newQuestion.Rows.Count; i++)
            {
                var index = i;
                <MudGrid Class="mb-2" data-row-editor="@index">
                    <MudItem xs="5">
                        <MudTextField T="string" Variant="Variant.Outlined"
                                      Label="Statement"
                                      @bind-Value="_newQuestion.Rows[index].Label"
                                      Immediate="true" />
                    </MudItem>
                    <MudItem xs="5">
                        <MudTextField T="string" Variant="Variant.Outlined"
                                      Label="Value"
                                      @bind-Value="_newQuestion.Rows[index].Value"
                                      Immediate="true" />
                    </MudItem>
                    <MudItem xs="2" Class="d-flex align-center">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       aria-label="Remove row"
                                       OnClick="() => RemoveRow(index)" />
                    </MudItem>
                </MudGrid>
            }

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddRow"
                       Class="mb-4">
                Add Row
            </MudButton>
        }

        @if (ShowsOptions)
        {
            <MudText Typo="Typo.subtitle1" Class="mb-2">@(IsLikert ? "Scale" : "Options")</MudText>
            @if (IsLikert)
            {
                <MudText Typo="Typo.body2" Class="mb-2">
                    The columns every row is rated on. Leave empty for Strongly disagree (1) to Strongly agree (5).
                </MudText>
            }
            @if (!AreOptionsValid)
            {
                <MudAlert Severity="Severity.Error" Class="mb-2">
                    Each option must have a non-empty label and value.
                </MudAlert>
            }

            @for (int i = 0; i < _newQuestion.Options.Count; i++)
            {
                var index = i;
                <MudGrid Class="mb-2" data-option-row="@index">
                    <MudItem xs="5">
                        <MudTextField T="string" Variant="Variant.Outlined"
                                      Label="Label"
                                      @bind-Value="_newQuestion.Options[index].Label"
                                      Immediate="true" />
                    </MudItem>
                    <MudItem xs="5">
                        <MudTextField T="string" Variant="Variant.Outlined"
                                      Label="Value"
                                      @bind-Value="_newQuestion.Options[index].Value"
                                      Immediate="true" />
                    </MudItem>
                    <MudItem xs="2" Class="d-flex align-center">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       aria-label="Remove option"
                                       OnClick="() => RemoveOption(index)" />
                    </MudItem>
                </MudGrid>
            }

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddOption"
                       Class="mb-4">
                Add Option
            </MudButton>
        }

        @if (IsRating)
        {
            <MudText Typo="Typo.subtitle1" Class="mb-2">Answer rules</MudText>
            <MudNumericField T="int?" Variant="Variant.Outlined" Label="Number of stars" @bind-Value="_maxValue"
                             Min="2" Max="@QuestionTypes.MaxRatingScale" Clearable="true"
                             HelperText="@($"From 2 to {QuestionTypes.MaxRatingScale}. Leave empty for {QuestionTypes.DefaultRatingScale}.")"
                             Class="mb-4" />
        }
        else if (HasLengthRules || HasValueRules)
        {
            <MudText Typo="Typo.subtitle1" Class="mb-2">Answer rules</MudText>
            <MudGrid Class="mb-4">
                @if (HasLengthRules)
                {
                    <MudItem xs="6">
                        <MudNumericField T="int?" Variant="Variant.Outlined" Label="Minimum length" @bind-Value="_minLength" Min="0" Clearable="true" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudNumericField T="int?" Variant="Variant.Outlined" Label="Maximum length" @bind-Value="_maxLength" Min="0" Clearable="true" />
                    </MudItem>
                }
                else
                {
                    <MudItem xs="6">
                        <MudNumericField T="int?" Variant="Variant.Outlined" Label="Minimum value" @bind-Value="_minValue" Clearable="true"
                                         HelperText="@(IsSlider ? $"Leave empty for {QuestionTypes.DefaultSliderMin}." : null)" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudNumericField T="int?" Variant="Variant.Outlined" Label="Maximum value" @bind-Value="_maxValue" Clearable="true"
                                         HelperText="@(IsSlider ? $"Leave empty for {QuestionTypes.DefaultSliderMax}." : null)" />
                    </MudItem>
                }
            </MudGrid>
        }

        <MudText Typo="Typo.subtitle1" Class="mb-2">Visibility</MudText>
        @if (_bankError)
        {
            <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">
                Could not load questions, so this question can't be made conditional right now.
            </MudAlert>
        }
        else if (YesNoQuestions.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mb-4">
                Always shown. Add a yes/no question to make other questions conditional.
            </MudText>
        }
        else
        {
            <MudGrid Class="mb-4">
                <MudItem xs="7">
                    <MudSelect T="string" Variant="Variant.Outlined" Label="Only show when" @bind-Value="_visibleIfKey" Clearable="true"
                               Placeholder="Always shown">
                        @foreach (var q in YesNoQuestions)
                        {
                            <MudSelectItem T="string" Value="@q.Key">@q.Label</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="5">
                    <MudSelect T="bool" Variant="Variant.Outlined" Label="is answered" @bind-Value="_visibleIfEquals" Disabled="@(_visibleIfKey is null)">
                        <MudSelectItem T="bool" Value="true">Yes</MudSelectItem>
                        <MudSelectItem T="bool" Value="false">No</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>
        }

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(!CanCreate || _isSubmitting)"
                   OnClick="SaveQuestionAsync">
            
            @if (_isSubmitting)
            {
                <MudProgressCircular 
                    Size="Size.Small" 
                    Indeterminate="true" 
                    Class="ml-2" />
                <span> Saving...</span>
            }else
            {
                <span>@(IsEdit ? "Save Changes" : "Create Question")</span>
            }
            
        </MudButton>
    </MudForm>
    }
</MudPaper>

@code {
    [Parameter] public Guid? Id { get; set; }

    private MudForm? _form;
    private bool _isValid;

    private bool _isSubmitting;

    private string? _errorMessage;
    private string? _successMessage;
    private bool _notFound;
    private bool _notYours;

    /// <summary>Whether to show the form: always when creating, and when editing a question this account may change.</summary>
    private bool CanEdit => !_notFound && !_notYours;

    [CascadingParameter] public AdminAccess? Access { get; set; }

    private NewQuestion _newQuestion = new();
    private List<QuestionDefinition> _bank = new();
    private bool _bankError;

    private int? _minLength;
    private int? _maxLength;
    private int? _minValue;
    private int? _maxValue;
    private string? _visibleIfKey;
    private bool _visibleIfEquals = true;

    private bool IsEdit => Id is not null;

    private bool IsOptionBasedType => QuestionTypes.IsChoice(_newQuestion.Type);
    private bool IsLikert => IsType(QuestionTypes.Likert);
    private bool IsSlider => IsType(QuestionTypes.Slider);

    /// <summary>Choice questions list their options; a likert grid can list its scale, or use the default one.</summary>
    private bool ShowsOptions => IsOptionBasedType || IsLikert;
    private bool AreOptionsValid =>
        !ShowsOptions ||
        ((_newQuestion.Options.Count > 0 || IsLikert) &&
         _newQuestion.Options.All(o =>
            !string.IsNullOrWhiteSpace(o.Label) &&
            !string.IsNullOrWhiteSpace(o.Value)));

    private bool AreRowsValid =>
        !IsLikert ||
        (_newQuestion.Rows.Count > 0 &&
         _newQuestion.Rows.All(r =>
            !string.IsNullOrWhiteSpace(r.Label) &&
            !string.IsNullOrWhiteSpace(r.Value) &&
            !r.Value.Contains(QuestionTypes.LikertSeparator)));

    private bool HasLengthRules => QuestionTypes.HasLengthRules(_newQuestion.Type);
    private bool HasValueRules => IsType(QuestionTypes.Number) || IsSlider;
    private bool IsRating => IsType(QuestionTypes.Rating);

    private bool IsType(string type) => string.Equals(_newQuestion.Type, type, StringComparison.OrdinalIgnoreCase);

    /// <summary>Yes/no questions this one could depend on (never itself).</summary>
    private List<QuestionDefinition> YesNoQuestions =>
        _bank.Where(q => string.Equals(q.Type, QuestionTypes.YesNo, StringComparison.OrdinalIgnoreCase) && q.Id != Id).ToList();

    // MudForm only reports valid once every required field has been touched, which a
    // loaded question never is, so edit mode relies on the explicit checks below.
    private bool CanCreate =>
        (_isValid || IsEdit) &&
        AreOptionsValid &&
        AreRowsValid &&
        !string.IsNullOrWhiteSpace(_newQuestion.Label) &&
        !string.IsNullOrWhiteSpace(_newQuestion.Key) &&
        !string.IsNullOrWhiteSpace(_newQuestion.Type);

    protected override async Task OnInitializedAsync()
    {
        var bank = await QuestionService.GetAllQuestionsAsync();
        _bank = bank ?? new();
        _bankError = bank is null;

        if (Id is { } id)
        {
            var existing = await QuestionService.GetQuestionAsync(id);
            if (existing is null)
            {
                _notFound = true;
                return;
            }
            if (!(Access ?? AdminAccess.Administrator).CanManage(existing))
            {
                _notYours = true;
                return;
            }
            Load(existing);
        }
    }

    private void Load(QuestionDefinition q)
    {
        _newQuestion = new NewQuestion
        {
            Label = q.Label,
            Key = q.Key,
            Type = q.Type,
            Required = q.Required,
            Placeholder = q.Placeholder,
            DefaultValue = q.DefaultValue,
            HelpText = q.HelpText,
            Options = q.Options.Select(o => new Option { Label = o.Label, Value = o.Value }).ToList(),
            Rows = q.Rows.Select(r => new Option { Label = r.Label, Value = r.Value }).ToList()
        };
        _visibleIfKey = q.VisibleIf?.Key;
        _visibleIfEquals = q.VisibleIf?.ShouldEqual ?? true;
        ReadRules(q.ValidationConfigs);
    }

    private void ReadRules(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return;
        }
        try
        {
            foreach (var rule in JsonNode.Parse(json)?.AsArray() ?? new JsonArray())
            {
                int? Get(string name) => rule?[name]?.GetValue<int>();
                switch (rule?["validationType"]?.GetValue<string>())
                {
                    case ValidationTypes.MinLength: _minLength = Get("minLength"); break;
                    case ValidationTypes.MaxLength: _maxLength = Get("maxLength"); break;
                    case ValidationTypes.MinValue: _minValue = Get("minValue"); break;
                    case ValidationTypes.MaxValue: _maxValue = Get("maxValue"); break;
                    case ValidationTypes.Range: _minValue = Get("minValue"); _maxValue = Get("maxValue"); break;
                }
            }
        }
        catch (Exception ex) when (ex is JsonException or InvalidOperationException or FormatException)
        {
            // Rules the form cannot show are left out; saving replaces them.
        }
    }

    /// <summary>Builds the ValidationConfigs JSON from the rule fields that apply to the type.</summary>
    private string? BuildRules()
    {
        var rules = new List<object>();
        if (HasLengthRules)
        {
            if (_minLength is { } min) rules.Add(new { validationType = ValidationTypes.MinLength, minLength = min });
            if (_maxLength is { } max) rules.Add(new { validationType = ValidationTypes.MaxLength, maxLength = max });
        }
        else if (HasValueRules)
        {
            if (_minValue is { } min) rules.Add(new { validationType = ValidationTypes.MinValue, minValue = min });
            if (_maxValue is { } max) rules.Add(new { validationType = ValidationTypes.MaxValue, maxValue = max });
        }
        else if (IsRating && _maxValue is { } stars)
        {
            rules.Add(new { validationType = ValidationTypes.MaxValue, maxValue = stars });
        }
        return rules.Count == 0 ? null : JsonSerializer.Serialize(rules);
    }

    private void AddOption()
    {
        _newQuestion.Options.Add(new Option { Label = string.Empty, Value = string.Empty });
    }

    private void RemoveOption(int index)
    {
        _newQuestion.Options.RemoveAt(index);
    }

    private void AddRow()
    {
        _newQuestion.Rows.Add(new Option { Label = string.Empty, Value = string.Empty });
    }

    private void RemoveRow(int index)
    {
        _newQuestion.Rows.RemoveAt(index);
    }

    private async Task SaveQuestionAsync()
    {
        if (_form is null || !CanCreate || _isSubmitting)
            return;

        _isSubmitting = true;
        try
        {
            await _form.ValidateAsync();
            if (!_isValid && !IsEdit)
                return;

            _successMessage = null;
            _errorMessage = null;

            if (!ShowsOptions)
            {
                _newQuestion.Options = new();
            }
            if (!IsLikert)
            {
                _newQuestion.Rows = new();
            }
            _newQuestion.ValidationConfigs = BuildRules();
            _newQuestion.VisibleIf = _visibleIfKey is null
                ? null
                : new VisibleIf { Key = _visibleIfKey, ShouldEqual = _visibleIfEquals };

            var (success, error) = Id is { } id
                ? await QuestionService.UpdateQuestionAsync(id, _newQuestion)
                : await QuestionService.CreateQuestionAsync(_newQuestion);

            if (success && IsEdit)
            {
                Snackbar.Add($"Question '{_newQuestion.Label}' saved.", Severity.Success);
                Nav.NavigateTo("/admin/questions");
            }
            else if (success)
            {
                _successMessage = $"Question '{_newQuestion.Label}' created successfully.";
                _newQuestion = new();
                _minLength = _maxLength = _minValue = _maxValue = null;
                _visibleIfKey = null;
                _visibleIfEquals = true;
                _isValid = false;
                _form = null;
                _bank = await QuestionService.GetAllQuestionsAsync() ?? _bank;
            }
            else
            {
                _errorMessage = error ?? "An error occurred while saving the question.";
            }
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
