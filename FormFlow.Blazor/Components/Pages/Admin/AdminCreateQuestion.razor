@page "/admin/questions/create"
@page "/admin/questions/{Id:guid}/edit"
@using System.Text.Json
@using System.Text.Json.Nodes
@using FormFlow.Blazor.Services
@inject IQuestionService QuestionService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>@(IsEdit ? "Edit Question" : "Create Question")</PageTitle>

<MudPaper Class="pa-6" MaxWidth="600px">
    <MudText Typo="Typo.h5" Class="mb-4">@(IsEdit ? "Edit Question" : "Create Question")</MudText>
    @if (_notFound)
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4">Question not found.</MudAlert>
    }
    @if (_successMessage is not null)
    {
        <MudAlert Severity="Severity.Success" 
            Class="mb-4" 
            ShowCloseIcon="true" 
            CloseIconClicked="()=> _successMessage = null">
                @_successMessage
        </MudAlert>
    }
    @if (_errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" 
            Class="mb-4" 
            ShowCloseIcon="true" 
            CloseIconClicked="()=> _errorMessage = null">
                @_errorMessage
        </MudAlert>
    }

    <MudForm @ref="_form" Model="@newQuestion" @bind-IsValid="_isValid">
        <MudTextField T="string"
                      Label="Label"
                      @bind-Value="newQuestion.Label"
                      Required="true"
                      RequiredError="Label is required."
                      Immediate="true"
                      Class="mb-3" />

        <MudTextField T="string"
                      Label="Key"
                      @bind-Value="newQuestion.Key"
                      Required="true"
                      RequiredError="Key is required."
                      Immediate="true"
                      Class="mb-3" />

        <MudSelect T="string"
                   Label="Type"
                   @bind-Value="newQuestion.Type"
                   Required="true"
                   RequiredError="Type is required."
                   Immediate="true"
                   Class="mb-3">
            <MudSelectItem Value='@("dropdown")'>Dropdown</MudSelectItem>
            <MudSelectItem Value='@("text")'>Text</MudSelectItem>
            <MudSelectItem Value='@("yes_no")'>Yes/No</MudSelectItem>
            <MudSelectItem Value='@("number")'>Number</MudSelectItem>
            <MudSelectItem Value='@("multiselect")'>Multi-Select</MudSelectItem>
            <MudSelectItem Value='@("checkbox")'>Checkbox</MudSelectItem>
            <MudSelectItem Value='@("radio")'>Radio</MudSelectItem>
        </MudSelect>

        <MudSwitch T="bool"
                   Label="Required"
                   @bind-Value="newQuestion.Required"
                   Color="Color.Primary"
                   Class="mb-3" />

        <MudTextField T="string"
                      Label="Placeholder"
                      @bind-Value="newQuestion.Placeholder"
                      Immediate="true"
                      Class="mb-3" />

        <MudTextField T="string"
                      Label="Default Value"
                      @bind-Value="newQuestion.DefaultValue"
                      Immediate="true"
                      Class="mb-3" />

        <MudTextField T="string"
                      Label="Help Text"
                      @bind-Value="newQuestion.HelpText"
                      Immediate="true"
                      Lines="3"
                      Class="mb-4" />

        @if (IsOptionBasedType)
        {
            <MudText Typo="Typo.subtitle1" Class="mb-2">Options</MudText>
            @if (!AreOptionsValid)
            {
                <MudAlert Severity="Severity.Error" Class="mb-2">
                    Each option must have a non-empty label and value.
                </MudAlert>
            }

            @for (int i = 0; i < newQuestion.Options.Count; i++)
            {
                var index = i;
                <MudGrid Class="mb-2" data-option-row="@index">
                    <MudItem xs="5">
                        <MudTextField T="string"
                                      Label="Label"
                                      @bind-Value="newQuestion.Options[index].Label"
                                      Immediate="true" />
                    </MudItem>
                    <MudItem xs="5">
                        <MudTextField T="string"
                                      Label="Value"
                                      @bind-Value="newQuestion.Options[index].Value"
                                      Immediate="true" />
                    </MudItem>
                    <MudItem xs="2" Class="d-flex align-center">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       aria-label="Remove option"
                                       OnClick="() => RemoveOption(index)" />
                    </MudItem>
                </MudGrid>
            }

            <MudButton Variant="Variant.Outlined"
                       Color="Color.Secondary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="AddOption"
                       Class="mb-4">
                Add Option
            </MudButton>
        }

        @if (HasLengthRules || HasValueRules)
        {
            <MudText Typo="Typo.subtitle1" Class="mb-2">Answer rules</MudText>
            <MudGrid Class="mb-4">
                @if (HasLengthRules)
                {
                    <MudItem xs="6">
                        <MudNumericField T="int?" Label="Minimum length" @bind-Value="_minLength" Min="0" Clearable="true" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudNumericField T="int?" Label="Maximum length" @bind-Value="_maxLength" Min="0" Clearable="true" />
                    </MudItem>
                }
                else
                {
                    <MudItem xs="6">
                        <MudNumericField T="int?" Label="Minimum value" @bind-Value="_minValue" Clearable="true" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudNumericField T="int?" Label="Maximum value" @bind-Value="_maxValue" Clearable="true" />
                    </MudItem>
                }
            </MudGrid>
        }

        <MudText Typo="Typo.subtitle1" Class="mb-2">Visibility</MudText>
        @if (YesNoQuestions.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mb-4">
                Always shown. Add a yes/no question to make other questions conditional.
            </MudText>
        }
        else
        {
            <MudGrid Class="mb-4">
                <MudItem xs="7">
                    <MudSelect T="string" Label="Only show when" @bind-Value="_visibleIfKey" Clearable="true"
                               Placeholder="Always shown">
                        @foreach (var q in YesNoQuestions)
                        {
                            <MudSelectItem T="string" Value="@q.Key">@q.Label</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="5">
                    <MudSelect T="bool" Label="is answered" @bind-Value="_visibleIfEquals" Disabled="@(_visibleIfKey is null)">
                        <MudSelectItem T="bool" Value="true">Yes</MudSelectItem>
                        <MudSelectItem T="bool" Value="false">No</MudSelectItem>
                    </MudSelect>
                </MudItem>
            </MudGrid>
        }

        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   Disabled="@(!CanCreate)"
                   OnClick="CreateQuestion">
            
            @if (_isSubmitting)
            {
                <MudProgressCircular 
                    Size="Size.Small" 
                    Indeterminate="true" 
                    Class="ml-2" />
                <span> Saving...</span>
            }else
            {
                <span>@(IsEdit ? "Save Changes" : "Create Question")</span>
            }
            
        </MudButton>
    </MudForm>
</MudPaper>

@code {
    [Parameter] public Guid? Id { get; set; }

    private MudForm? _form;
    private bool _isValid;

    bool _isSubmitting;

    private string? _errorMessage;
    private string? _successMessage;
    private bool _notFound;

    private NewQuestion newQuestion = new();
    private List<QuestionDefinition> _bank = new();

    private int? _minLength;
    private int? _maxLength;
    private int? _minValue;
    private int? _maxValue;
    private string? _visibleIfKey;
    private bool _visibleIfEquals = true;

    private bool IsEdit => Id is not null;

    private static readonly HashSet<string> OptionBasedTypes =
        new(StringComparer.OrdinalIgnoreCase) { "dropdown", "radio", "checkbox", "multiselect" };

    private bool IsOptionBasedType => OptionBasedTypes.Contains(newQuestion.Type);
    private bool AreOptionsValid =>
        !IsOptionBasedType ||
        (newQuestion.Options.Count > 0 &&
         newQuestion.Options.All(o => 
            !string.IsNullOrWhiteSpace(o.Label) && 
            !string.IsNullOrWhiteSpace(o.Value)));

    private bool HasLengthRules => string.Equals(newQuestion.Type, "text", StringComparison.OrdinalIgnoreCase);
    private bool HasValueRules => string.Equals(newQuestion.Type, "number", StringComparison.OrdinalIgnoreCase);

    /// <summary>Yes/no questions this one could depend on (never itself).</summary>
    private List<QuestionDefinition> YesNoQuestions =>
        _bank.Where(q => q.Type == "yes_no" && q.Id != Id).ToList();

    // MudForm only reports valid once every required field has been touched, which a
    // loaded question never is, so edit mode relies on the explicit checks below.
    private bool CanCreate =>
        (_isValid || IsEdit) &&
        AreOptionsValid &&
        !string.IsNullOrWhiteSpace(newQuestion.Label) &&
        !string.IsNullOrWhiteSpace(newQuestion.Key) &&
        !string.IsNullOrWhiteSpace(newQuestion.Type);

    protected override async Task OnInitializedAsync()
    {
        _bank = await QuestionService.GetAllQuestionsAsync() ?? new();

        if (Id is { } id)
        {
            var existing = await QuestionService.GetQuestionAsync(id);
            if (existing is null)
            {
                _notFound = true;
                return;
            }
            Load(existing);
        }
    }

    private void Load(QuestionDefinition q)
    {
        newQuestion = new NewQuestion
        {
            Label = q.Label,
            Key = q.Key,
            Type = q.Type,
            Required = q.Required,
            Placeholder = q.Placeholder,
            DefaultValue = q.DefaultValue,
            HelpText = q.HelpText,
            Options = q.Options.Select(o => new Option { Label = o.Label, Value = o.Value }).ToList()
        };
        _visibleIfKey = q.VisibleIf?.Key;
        _visibleIfEquals = q.VisibleIf?.ShouldEqual ?? true;
        ReadRules(q.ValidationConfigs);
    }

    private void ReadRules(string? json)
    {
        if (string.IsNullOrWhiteSpace(json))
        {
            return;
        }
        try
        {
            foreach (var rule in JsonNode.Parse(json)?.AsArray() ?? new JsonArray())
            {
                int? Get(string name) => rule?[name]?.GetValue<int>();
                switch (rule?["validationType"]?.GetValue<string>())
                {
                    case "MinLength": _minLength = Get("minLength"); break;
                    case "MaxLength": _maxLength = Get("maxLength"); break;
                    case "MinValue": _minValue = Get("minValue"); break;
                    case "MaxValue": _maxValue = Get("maxValue"); break;
                    case "Range": _minValue = Get("minValue"); _maxValue = Get("maxValue"); break;
                }
            }
        }
        catch (Exception ex) when (ex is JsonException or InvalidOperationException or FormatException)
        {
            // Rules the form cannot show are left out; saving replaces them.
        }
    }

    /// <summary>Builds the ValidationConfigs JSON from the rule fields that apply to the type.</summary>
    private string? BuildRules()
    {
        var rules = new List<object>();
        if (HasLengthRules)
        {
            if (_minLength is { } min) rules.Add(new { validationType = "MinLength", minLength = min });
            if (_maxLength is { } max) rules.Add(new { validationType = "MaxLength", maxLength = max });
        }
        else if (HasValueRules)
        {
            if (_minValue is { } min) rules.Add(new { validationType = "MinValue", minValue = min });
            if (_maxValue is { } max) rules.Add(new { validationType = "MaxValue", maxValue = max });
        }
        return rules.Count == 0 ? null : JsonSerializer.Serialize(rules);
    }

    private void AddOption()
    {
        newQuestion.Options.Add(new Option { Label = string.Empty, Value = string.Empty });
    }

    private void RemoveOption(int index)
    {
        newQuestion.Options.RemoveAt(index);
    }

    private async Task CreateQuestion()
    {
        if (_form is null || !CanCreate)
            return;

        await _form.ValidateAsync();

        if (!_isValid && !IsEdit)
            return;
        _isSubmitting = true;
        _successMessage = null;
        _errorMessage = null;

        if (!IsOptionBasedType)
        {
            newQuestion.Options = new();
        }
        newQuestion.ValidationConfigs = BuildRules();
        newQuestion.VisibleIf = _visibleIfKey is null
            ? null
            : new VisibleIf { Key = _visibleIfKey, ShouldEqual = _visibleIfEquals };

        var (success, error) = Id is { } id
            ? await QuestionService.UpdateQuestionAsync(id, newQuestion)
            : await QuestionService.CreateQuestionAsync(newQuestion);
        
        if(success && IsEdit)
        {
            Snackbar.Add($"Question '{newQuestion.Label}' saved.", Severity.Success);
            Nav.NavigateTo("/admin/questions");
        }
        else if(success)
        {
            _successMessage = $"Question '{newQuestion.Label}' created successfully.";
            newQuestion = new();
            _minLength = _maxLength = _minValue = _maxValue = null;
            _visibleIfKey = null;
            _visibleIfEquals = true;
            _isValid = false;
            _form = null;
            _bank = await QuestionService.GetAllQuestionsAsync() ?? _bank;
        }
        else
        {
            _errorMessage = error ?? "An error occurred while saving the question.";
        }
        _isSubmitting = false;

    }
}
