@page "/admin/surveys/create"
@page "/admin/surveys/{Id:guid}/edit"
@using FormFlow.Blazor.Services
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IQuestionService QuestionService
@inject ISurveyService SurveyService

<PageTitle>@(IsEdit ? "Edit Survey" : "Create Survey")</PageTitle>

<MudPaper Class="pa-6" Elevation="1">

        <PageHeading>@(IsEdit ? "Edit Survey" : "Create Survey")</PageHeading>

        @if (_notFound)
        {
            <MudAlert Severity="Severity.Warning">Survey not found.</MudAlert>
        }
        else if (_notYours)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">You can only edit surveys you created.</MudAlert>
            <MudButton Variant="Variant.Outlined" Href="/admin/surveys">Back to surveys</MudButton>
        }
        else
        {
        <MudForm @ref="_form" @bind-IsValid="_isValid">

            <MudTextField @bind-Value="_newSurvey.Title"
                        Label="Survey Title"
                        Variant="Variant.Outlined"
                        Class="mb-4"
                        Immediate="true"
                        Required="true"
                        RequiredError="Title is required" />

            <MudTextField @bind-Value="_newSurvey.Description"
                        Label="Description"
                        Variant="Variant.Outlined"
                        Lines="4"
                        Class="mb-6"
                        Immediate=true
                        Required="true"
                        RequiredError="Description is required." />

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Select Questions</MudText>

            @if (_questionBankError)
            {
                <MudAlert Severity="Severity.Error" Dense="true">Could not load questions. Reload the page to try again.</MudAlert>
            }
            else if (_questionBank is null)
            {
                <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
            }
            else if (!_questionBank.Any())
            {
                <MudText>No questions found.</MudText>
            }
            else
            {
                <MudPaper Class="question-bank">
                    <MudList T="QuestionDefinition" Dense="true" Class="mb-6">
                        @foreach (var q in _questionBank)
                        {
                            <MudListItem>
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mud-width-full">
                                    <div>
                                        <MudText Typo="Typo.subtitle1">@q.Label</MudText>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@QuestionTypes.DisplayName(q.Type)</MudText>
                                    </div>

                                    <MudButton Variant="Variant.Filled"
                                            Color="Color.Primary"
                                            Disabled="@IsSelected(q)"
                                            OnClick="@(() => AddQuestionAsync(q))">
                                        @(IsSelected(q) ? "Added" : "Add")        
                                    </MudButton>
                                </MudStack>
                            </MudListItem>
                        }
                    </MudList>
                </MudPaper>
            }

            <MudDivider Class="my-4" />

            <MudText Typo="Typo.h6" HtmlTag="h2" Class="mb-2">Selected Questions</MudText>

            @if (!_selectedQuestions.Any())
            {
                <MudText>No questions selected yet.</MudText>
            }
            else
            {
                @if (DependencyWarnings.Any())
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                        @foreach (var warning in DependencyWarnings)
                        {
                            <div>@warning</div>
                        }
                    </MudAlert>
                }

                <MudList T="QuestionDefinition" Dense="true" Class="mb-6">
                    @for (var i = 0; i < _selectedQuestions.Count; i++)
                    {
                        var index = i;
                        var q = _selectedQuestions[index];
                        <MudListItem>

                            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mud-width-full">
                                <MudText>@(index + 1). @q.Label</MudText>

                                <MudStack Row="true" Spacing="1">
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward"
                                            aria-label="Move up"
                                            Disabled="@(index == 0)"
                                            OnClick="@(() => Move(index, -1))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward"
                                            aria-label="Move down"
                                            Disabled="@(index == _selectedQuestions.Count - 1)"
                                            OnClick="@(() => Move(index, 1))" />
                                    <MudButton StartIcon="@Icons.Material.Filled.Delete"
                                            Color="Color.Error"
                                            OnClick="@(() => RemoveQuestionAsync(q))">
                                        Remove
                                    </MudButton>
                                </MudStack>
                            </MudStack>

                        </MudListItem>
                    }
                </MudList>
            }

            <MudDivider Class="my-4" />

            <MudButton Variant="Variant.Filled"
                    Color="Color.Success"
                    Disabled="@(!CanSave || _saving)"
                    OnClick="SaveSurveyAsync">

                @(_saving ? "Saving..." : IsEdit ? "Save Changes" : "Save Survey")

            </MudButton>
        </MudForm>
        }

</MudPaper>

@code {
    [Parameter] public Guid? Id { get; set; }

    private MudForm? _form;
    private bool _isValid;
    private bool _notFound;
    private bool _notYours;
    private bool _saving;

    [CascadingParameter] public AdminAccess? Access { get; set; }

    private NewSurvey _newSurvey = new();

    private List<QuestionDefinition>? _questionBank;
    private bool _questionBankError;
    private List<QuestionDefinition> _selectedQuestions = new();

    private bool IsEdit => Id is not null;

    protected override async Task OnInitializedAsync()
    {
        _questionBank = await QuestionService.GetAllQuestionsAsync();
        _questionBankError = _questionBank is null;

        if (Id is { } id)
        {
            var survey = await SurveyService.GetSurveyAsync(id);
            if (survey is null)
            {
                _notFound = true;
                return;
            }
            if (!(Access ?? AdminAccess.Administrator).CanManage(survey))
            {
                _notYours = true;
                return;
            }

            _newSurvey = new NewSurvey { Title = survey.Title, Description = survey.Description };
            var byId = (_questionBank ?? new()).ToDictionary(q => q.Id);
            foreach (var qid in survey.QuestionIds)
            {
                if (byId.TryGetValue(qid, out var q))
                {
                    _newSurvey.QuestionIds.Add(q.Id);
                    _selectedQuestions.Add(q);
                }
            }
        }
    }

    private bool IsSelected(QuestionDefinition q)
        => _selectedQuestions.Any(x => x.Id == q.Id);

    /// <summary>
    /// Conditional questions only make sense after the yes/no question they depend on.
    /// </summary>
    private IEnumerable<string> DependencyWarnings
    {
        get
        {
            for (var i = 0; i < _selectedQuestions.Count; i++)
            {
                var rule = _selectedQuestions[i].VisibleIf;
                if (rule is null)
                {
                    continue;
                }

                var controllerIndex = _selectedQuestions.FindIndex(q => q.Key == rule.Key);
                if (controllerIndex < 0)
                {
                    yield return $"\"{_selectedQuestions[i].Label}\" depends on \"{rule.Key}\", which is not in this survey, so it will never show.";
                }
                else if (controllerIndex > i)
                {
                    yield return $"\"{_selectedQuestions[i].Label}\" appears before the question it depends on.";
                }
            }
        }
    }

    private async Task AddQuestionAsync(QuestionDefinition q)
    {
        if (!IsSelected(q))
        {
            _newSurvey.QuestionIds.Add(q.Id);
            _selectedQuestions.Add(q);
            await ValidateAsync();
        }
    }

    private async Task RemoveQuestionAsync(QuestionDefinition q)
    {
        _newSurvey.QuestionIds.Remove(q.Id);
        _selectedQuestions.RemoveAll(x => x.Id == q.Id);
        await ValidateAsync();
    }

    private Task ValidateAsync() => _form?.ValidateAsync() ?? Task.CompletedTask;

    private void Move(int index, int offset)
    {
        var target = index + offset;
        if (target < 0 || target >= _selectedQuestions.Count)
        {
            return;
        }

        (_selectedQuestions[index], _selectedQuestions[target]) = (_selectedQuestions[target], _selectedQuestions[index]);
        _newSurvey.QuestionIds = _selectedQuestions.Select(q => q.Id).ToList();
    }

    // MudForm only reports valid once every required field has been touched, which a
    // loaded survey never is, so edit mode checks the required fields directly.
    private bool CanSave =>
        (_isValid || (IsEdit && !string.IsNullOrWhiteSpace(_newSurvey.Title) && !string.IsNullOrWhiteSpace(_newSurvey.Description)))
        && _newSurvey.QuestionIds.Any();

    private async Task SaveSurveyAsync()
    {
        if (_form is null || _saving)
            return;

        _saving = true;
        try
        {
            await _form.ValidateAsync();

            if (!CanSave)
            {
                Snackbar.Add("Please complete all required fields before saving.", Severity.Warning);
                return;
            }

            var (success, error) = Id is { } id
                ? await SurveyService.UpdateSurveyAsync(id, _newSurvey)
                : await SurveyService.CreateSurveyAsync(_newSurvey);

            if (success)
            {
                Snackbar.Add(IsEdit ? "Survey saved." : "Survey created as a draft. Use Share to publish it.", Severity.Success);
                Nav.NavigateTo("/admin/surveys");
            }
            else
            {
                Snackbar.Add(error ?? "Failed to save the survey. Please try again.", Severity.Error);
            }
        }
        finally
        {
            _saving = false;
        }
    }
}
