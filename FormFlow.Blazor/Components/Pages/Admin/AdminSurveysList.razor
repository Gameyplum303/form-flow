@page "/admin/surveys"
@inject ISurveyService SurveyService
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Survey Management</PageTitle>

<MudPaper Class="pa-6" Elevation="2">

    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-4">

        <MudText Typo="Typo.h5" Class="mb-4">Survey Management</MudText>

        @if (CanEdit)
        {
            <MudButton Variant="Variant.Filled"
                    Color="Color.Primary"
                    Href="/admin/surveys/create">
                + Create Survey
            </MudButton>
        }

    </MudStack>

    @if (surveys is null)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (!surveys.Any())
    {
        <MudText>No surveys found.</MudText>
    }
    else
    {
        <MudTable Items="@surveys" 
                Hover="true" 
                Dense="true"
                Bordered="true"
                Elevation="3">
            <ToolBarContent>
                <MudText Typo="Typo.h6" Class="mb-2">Surveys</MudText>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Title</MudTh>
                <MudTh>Description</MudTh>
                <MudTh>Questions</MudTh>
                <MudTh></MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd>@context.Title</MudTd>
                <MudTd>@context.Description</MudTd>
                <MudTd>@context.QuestionIds.Count</MudTd>

                <MudTd>
                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">

                        @if (CanEdit)
                        {
                            <MudButton Variant="Variant.Filled"
                                    Color="Color.Primary"
                                    Size="Size.Small"
                                    OnClick="@(_ => Nav.NavigateTo($"/admin/surveys/{context.Id}/edit"))">
                                Edit
                            </MudButton>
                        }

                        <MudButton Variant="Variant.Filled"
                                Color="Color.Primary"
                                Size="Size.Small"
                                OnClick="@(_ => PreviewSurvey(context.Id))">
                            Preview 
                        </MudButton>

                        <MudButton Variant="Variant.Filled"
                                Color="Color.Secondary"
                                Size="Size.Small"
                                OnClick="@(_ => Nav.NavigateTo($"/admin/surveys/{context.Id}/results"))">
                            Results
                        </MudButton>

                        @if (CanEdit)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                    Color="Color.Error"
                                    Size="Size.Small"
                                    aria-label="@($"Delete {context.Title}")"
                                    OnClick="@(_ => DeleteSurvey(context))" />
                        }

                    </MudStack>
                </MudTd>
            </RowTemplate>

            <PagerContent>
                <MudTablePager RowsPerPageString="10" />
            </PagerContent>
    
        </MudTable>
    }
</MudPaper>  

@code {
    [CascadingParameter] public AdminAccess? Access { get; set; }

    /// <summary>View-only accounts don't get create, edit or delete buttons. Without a guard (in tests) everything shows.</summary>
    private bool CanEdit => Access?.CanEdit ?? true;

    private List<SurveyDefinition>? surveys;

    protected override async Task OnInitializedAsync()
    {
        surveys = await SurveyService.GetSurveysAsync();
    }

    private void PreviewSurvey(Guid Id)
    {
        Nav.NavigateTo($"/admin/surveys/{Id}/preview");
    }

    private async Task DeleteSurvey(SurveyDefinition survey)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete survey",
            $"Delete \"{survey.Title}\" and all of its responses? This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        var (deleted, error) = await SurveyService.DeleteSurveyAsync(survey.Id);
        if (deleted)
        {
            surveys?.Remove(survey);
            Snackbar.Add($"Deleted \"{survey.Title}\".", Severity.Success);
        }
        else
        {
            Snackbar.Add($"The survey could not be deleted: {error}", Severity.Error);
        }
    }
}
