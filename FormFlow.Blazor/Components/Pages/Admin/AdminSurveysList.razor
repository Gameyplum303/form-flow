@page "/admin/surveys"
@inject ISurveyService SurveyService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<PageTitle>Survey Management</PageTitle>

<MudPaper Class="pa-6" Elevation="1">

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <PageHeading CssClass="mb-0">Survey Management</PageHeading>

        @if (Current.CanBuild)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Href="/admin/surveys/create">
                Create Survey
            </MudButton>
        }
    </MudStack>

    @if (!_loaded)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (Surveys is null)
    {
        <MudAlert Severity="Severity.Error">Could not load surveys. Please try again.</MudAlert>
    }
    else if (!Surveys.Any())
    {
        <MudText>No surveys found.</MudText>
    }
    else
    {
        <MudTable Items="@Surveys"
                  Hover="true"
                  Dense="true"
                  Outlined="true"
                  Elevation="0">
            <HeaderContent>
                <MudTh>Survey</MudTh>
                <MudTh>Questions</MudTh>
                <MudTh>Status</MudTh>
                @if (Current.IsAdmin)
                {
                    <MudTh>Created by</MudTh>
                }
                <MudTh><span class="visually-hidden">Actions</span></MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd>
                    <MudText Typo="Typo.subtitle2">@context.Title</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.Description</MudText>
                </MudTd>
                <MudTd>@context.QuestionIds.Count</MudTd>
                <MudTd><SurveyStatusChip Survey="context" /></MudTd>
                @if (Current.IsAdmin)
                {
                    <MudTd>@context.OwnerLabel()</MudTd>
                }

                <MudTd>
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Wrap="Wrap.NoWrap">
                        @if (Current.CanManage(context))
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                       Href="@($"/admin/surveys/{context.Id}/edit")">
                                Edit
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                       Href="@($"/admin/surveys/{context.Id}/share")">
                                Share
                            </MudButton>
                        }

                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                   Href="@($"/admin/surveys/{context.Id}/preview")">
                            Preview
                        </MudButton>

                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                   Href="@($"/admin/surveys/{context.Id}/results")">
                            Results
                        </MudButton>

                        @if (Current.CanBuild)
                        {
                            <MudTooltip Text="Duplicate">
                                <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               Disabled="_duplicating"
                                               aria-label="@($"Duplicate {context.Title}")"
                                               OnClick="@(_ => DuplicateSurveyAsync(context))" />
                            </MudTooltip>
                        }

                        @if (Current.CanManage(context))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           aria-label="@($"Delete {context.Title}")"
                                           OnClick="@(_ => DeleteSurveyAsync(context))" />
                        }
                    </MudStack>
                </MudTd>
            </RowTemplate>

            <PagerContent>
                <MudTablePager RowsPerPageString="Rows per page:" />
            </PagerContent>
        </MudTable>
    }
</MudPaper>  

@code {
    [CascadingParameter] public AdminAccess? Access { get; set; }

    /// <summary>Without a guard (in tests) the page shows an administrator's view.</summary>
    private AdminAccess Current => Access ?? AdminAccess.Administrator;

    private List<SurveyDefinition>? _managed;
    private bool _loaded;

    // The server returns every survey for an administrator and their own for a professor. An
    // administrator previewing the professor view sees only the surveys they created themselves.
    // Filtered on each render, so switching the preview on this page updates the list.
    private List<SurveyDefinition>? Surveys => _managed?.Where(Current.CanManage).ToList();

    protected override async Task OnInitializedAsync()
    {
        _managed = await SurveyService.GetManagedSurveysAsync();
        _loaded = true;
    }

    private bool _duplicating;

    /// <summary>Copies the survey into a new draft and opens it for editing.</summary>
    private async Task DuplicateSurveyAsync(SurveyDefinition survey)
    {
        _duplicating = true;
        var (copy, error) = await SurveyService.DuplicateSurveyAsync(survey.Id);
        _duplicating = false;
        if (copy is null)
        {
            Snackbar.Add($"The survey could not be duplicated: {error}", Severity.Error);
            return;
        }

        Snackbar.Add($"Created \"{copy.Title}\" as a draft.", Severity.Success);
        Nav.NavigateTo($"/admin/surveys/{copy.Id}/edit");
    }

    private async Task DeleteSurveyAsync(SurveyDefinition survey)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete survey",
            $"Delete \"{survey.Title}\" and all of its responses? This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        var (deleted, error) = await SurveyService.DeleteSurveyAsync(survey.Id);
        if (deleted)
        {
            _managed?.Remove(survey);
            Snackbar.Add($"Deleted \"{survey.Title}\".", Severity.Success);
        }
        else
        {
            Snackbar.Add($"The survey could not be deleted: {error}", Severity.Error);
        }
    }
}
