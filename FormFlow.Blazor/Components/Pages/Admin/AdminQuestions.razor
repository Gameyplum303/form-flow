@page "/admin/questions"
@using FormFlow.Blazor.Services
@inject IQuestionService QuestionService
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Question Management</PageTitle>

<MudPaper Class="pa-6" Elevation="1">

    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4">
        <PageHeading CssClass="mb-0">Question Management</PageHeading>

        @if (Current.CanBuild)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Href="/admin/questions/create">
                Create Question
            </MudButton>
        }
    </MudStack>

    @if (questions is null)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
    }
    else if (!questions.Any())
    {
        <MudText>No questions found.</MudText>
    }
    else
    {
        <MudTable Items="@questions"
                  Hover="true"
                  Dense="true"
                  Outlined="true"
                  Elevation="0">
            <HeaderContent>
                <MudTh>Label</MudTh>
                <MudTh>Key</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>Shown when</MudTh>
                <MudTh>Created by</MudTh>
                <MudTh><span class="visually-hidden">Actions</span></MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd>@context.Label</MudTd>
                <MudTd><code>@context.Key</code></MudTd>
                <MudTd>@QuestionTypes.DisplayName(context.Type)</MudTd>
                <MudTd>
                    @if (context.VisibleIf is { } rule)
                    {
                        <span>@rule.Key is @(rule.ShouldEqual ? "yes" : "no")</span>
                    }
                    else
                    {
                        <span>Always</span>
                    }
                </MudTd>

                <MudTd>@OwnerLabel(context)</MudTd>

                <MudTd>
                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center" Justify="Justify.FlexEnd" Wrap="Wrap.NoWrap">
                        @if (Current.CanManage(context))
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(_ => EditQuestion(context.Id))">
                                Edit
                            </MudButton>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           aria-label="@($"Delete {context.Label}")"
                                           OnClick="@(_ => DeleteQuestion(context))" />
                        }
                    </MudStack>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager RowsPerPageString="Rows per page:" />
            </PagerContent>
        </MudTable>
    }

</MudPaper>

@code {
    [CascadingParameter] public AdminAccess? Access { get; set; }

    /// <summary>Everyone can use every question; only its creator or an administrator can change it. Without a guard (in tests) everything shows.</summary>
    private AdminAccess Current => Access ?? AdminAccess.Administrator;

    /// <summary>The seeded demo questions have no owner and belong to the administrators.</summary>
    public static string OwnerLabel(IOwned item) => item.OwnerName ?? "Administrators";

    private List<QuestionDefinition>? questions;

    protected override async Task OnInitializedAsync()
    {
        questions = await QuestionService.GetAllQuestionsAsync() ?? [];
    }

    private void EditQuestion(Guid id)
    {
        Nav.NavigateTo($"/admin/questions/{id}/edit");
    }

    private async Task DeleteQuestion(QuestionDefinition question)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete question",
            $"Delete \"{question.Label}\"? This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        var (success, error) = await QuestionService.DeleteQuestionAsync(question.Id);
        if (success)
        {
            questions?.Remove(question);
            Snackbar.Add($"Deleted \"{question.Label}\".", Severity.Success);
        }
        else
        {
            // The API explains why, for example when a survey still uses the question.
            Snackbar.Add(error ?? "The question could not be deleted.", Severity.Error);
        }
    }
}
