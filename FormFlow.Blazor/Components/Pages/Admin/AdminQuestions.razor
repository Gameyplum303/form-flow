@page "/admin/questions"
@using FormFlow.Blazor.Services
@inject IQuestionService QuestionService
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Question Management</PageTitle>


<MudPaper Class="pa-4" Elevation="1">
    

    <MudStack Row="true" Justify="Justify.SpaceBetween" Class="mb-4">

        <MudText Typo="Typo.h5" Class="mb-2">Question Management</MudText>

        <MudButton Variant="Variant.Filled"
                    Color="Color.Primary"
                    Href="/admin/questions/create">
            Create New Question            
        </MudButton>
        
    </MudStack>

    @if (questions is null)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" /> 
    }
    else if (!questions.Any())
    {
        <MudText>No questions found.</MudText>
    }
    else
    {
        <MudTable Items="@questions" 
                Hover="true" 
                Dense="true"
                Bordered="true"
                Elevation="3">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Question Bank</MudText>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Label</MudTh>
                <MudTh>Key</MudTh>
                <MudTh>Type</MudTh>
                <MudTh>Shown when</MudTh>
                <MudTh></MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd>@context.Label</MudTd>
                <MudTd>@context.Key</MudTd>
                <MudTd>@context.Type</MudTd>
                <MudTd>
                    @if (context.VisibleIf is { } rule)
                    {
                        <span>@rule.Key is @(rule.ShouldEqual ? "yes" : "no")</span>
                    }
                    else
                    {
                        <span>Always</span>
                    }
                </MudTd>

                <MudTd>
                    <MudStack Row="true" Spacing="2">
                        <MudButton Variant="Variant.Filled"
                                Color="Color.Primary"
                                Size="Size.Small"
                                OnClick="@(_ => EditQuestion(context.Id))">
                            Edit        
                        </MudButton>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                Color="Color.Error"
                                Size="Size.Small"
                                aria-label="@($"Delete {context.Label}")"
                                OnClick="@(_ => DeleteQuestion(context))" />
                    </MudStack>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager RowsPerPageString="10" />
            </PagerContent>
        </MudTable>
    }

</MudPaper>

@code {
    private List<QuestionDefinition>? questions;

    protected override async Task OnInitializedAsync()
    {
        questions = await QuestionService.GetAllQuestionsAsync() ?? [];
    }

    private void EditQuestion(Guid id)
    {
        Nav.NavigateTo($"/admin/questions/{id}/edit");
    }

    private async Task DeleteQuestion(QuestionDefinition question)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete question",
            $"Delete \"{question.Label}\"? This cannot be undone.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        var (success, error) = await QuestionService.DeleteQuestionAsync(question.Id);
        if (success)
        {
            questions?.Remove(question);
            Snackbar.Add($"Deleted \"{question.Label}\".", Severity.Success);
        }
        else
        {
            // The API explains why, for example when a survey still uses the question.
            Snackbar.Add(error ?? "The question could not be deleted.", Severity.Error);
        }
    }
}
